function stripMarkup(s){return String(s||'').replace(/\[\/?(?:highlight|attribute(?:=[^\]]+)?)\]/g,'').replace(/\s+/g,' ').trim();}
function dataRows(raw,name){const arr=raw[name];if(!Array.isArray(arr))throw new Error(`${name} is missing or is not an array.`);return arr.map(x=>x&&x.data).filter(Boolean);}
function idMap(raw,name){return new Map(dataRows(raw,name).map(x=>[x.id,x]));}
function langMap(raw,name){return new Map(dataRows(raw,name).map(x=>[x.id,x.text]));}
function groupMapRows(rows,key){const out=new Map();for(const x of rows){const k=x[key];if(!out.has(k))out.set(k,new Map());out.get(k).set(Number(x.level),x);}return out;}
function groupListRows(rows,key){const out=new Map();for(const x of rows){const k=x[key];if(!out.has(k))out.set(k,[]);out.get(k).push(x);}return out;}
function rarityInt(value){const m=String(value||'').match(/_RARITY_(\d+)$/);return m?Number(m[1]):null;}
function normalizeHolodoriRaw(raw,sourceVersion){
  const cards=dataRows(raw,'Card.json'),chars=idMap(raw,'Character.json'),groups=idMap(raw,'CharacterGrouping.json'),langCard=langMap(raw,'LangCard_Eng.json'),langGroup=langMap(raw,'LangCharacterGrouping_Eng.json'),langPassive=langMap(raw,'LangGeneratedLivePassiveSkillLevel_Eng.json'),langActive=langMap(raw,'LangGeneratedLiveActiveSkillLevel_Eng.json'),langSpecial=langMap(raw,'LangGeneratedLiveSpecialSkillLevel_Eng.json'),langLeader=langMap(raw,'LangGeneratedLiveLeaderSkill_Eng.json');
  const groupLabels={};for(const [gid,g] of groups)groupLabels[gid]=langGroup.get(g.nameLangId)||gid;
  const charGroupIds=new Map();for(const cid of chars.keys())charGroupIds.set(cid,[]);
  for(const [gid,g] of groups)for(const cid of g.characterIds||[]){if(!charGroupIds.has(cid))charGroupIds.set(cid,[]);charGroupIds.get(cid).push(gid);}
  for(const [cid,ch] of chars)for(const gid of ch.regularCharacterGroupingIds||[]){const a=charGroupIds.get(cid)||[];if(!a.includes(gid))a.push(gid);charGroupIds.set(cid,a);}
  const levelByGroup=new Map();for(const x of dataRows(raw,'CardLevel.json')){if(!levelByGroup.has(x.groupId))levelByGroup.set(x.groupId,new Map());levelByGroup.get(x.groupId).set(Number(x.level),Number(x.parameterBaseValue));}
  const limitByGroup=new Map();for(const x of dataRows(raw,'CardLevelLimit.json')){if(!limitByGroup.has(x.groupId))limitByGroup.set(x.groupId,[]);limitByGroup.get(x.groupId).push(Number(x.levelLimit));}
  for(const arr of limitByGroup.values())arr.sort((a,b)=>a-b);
  const potentialByGroup=groupListRows(dataRows(raw,'CardPotential.json'),'groupId');for(const arr of potentialByGroup.values())arr.sort((a,b)=>Number(a.upgradeCount)-Number(b.upgradeCount));
  const activeLevels=groupMapRows(dataRows(raw,'LiveActiveSkillLevel.json'),'liveActiveSkillId'),passiveLevels=groupMapRows(dataRows(raw,'LivePassiveSkillLevel.json'),'livePassiveSkillId'),specialLevels=groupMapRows(dataRows(raw,'LiveSpecialSkillLevel.json'),'liveSpecialSkillId');
  const activeEffect=new Map(dataRows(raw,'LiveActiveSkillEffect.json').map(x=>[x.groupId,x])),passiveEffect=new Map(dataRows(raw,'LivePassiveSkillEffect.json').map(x=>[x.groupId,x])),targets=idMap(raw,'LiveSkillEffectTarget.json'),triggerRows=new Map(dataRows(raw,'LiveSkillTrigger.json').map(x=>[x.groupId,x])),leaders=idMap(raw,'LiveLeaderSkill.json');
  const groupByLabel=new Map(Object.entries(groupLabels).map(([id,label])=>[String(label).toLowerCase(),id]));
  const attrByMarkup={cute:'CardAttributeType_CARD_ATTRIBUTE_TYPE_ATTRIBUTE_1',pure:'CardAttributeType_CARD_ATTRIBUTE_TYPE_ATTRIBUTE_2',happy:'CardAttributeType_CARD_ATTRIBUTE_TYPE_ATTRIBUTE_3'};
  const normalizeTrigger=t=>{if(!t)return null;const typ=t.type||'';if(typ.endsWith('DECK_CARD_ATTRIBUTE'))return{kind:'attribute',id:t.cardAttributeType,count:Number(t.threshold||1)};if(typ.endsWith('DECK_CARD_CHARACTER_GROUPING'))return{kind:'group',id:t.characterGroupingId,count:Number(t.threshold||1)};if(typ.endsWith('COMBO_GTE'))return{kind:'combo_gte',threshold:Number(t.threshold||0)};if(typ.endsWith('LIFE_GTE'))return{kind:'life_gte',threshold:Number(t.threshold||0)};if(typ.endsWith('LIFE_LTE'))return{kind:'life_lte',threshold:Number(t.threshold||0)};if(typ.endsWith('JUDGEMENT_TYPE_GTE'))return{kind:'judgement_gte',threshold:Number(t.threshold||0),judgement:t.liveNoteJudgementType};return{kind:'unsupported',type:typ,threshold:t.threshold,groupId:t.characterGroupingId,attributeId:t.cardAttributeType};};
  const normalizeTarget=t=>{const typ=t.type||'';if(typ.endsWith('_ALL'))return{kind:'all'};if(typ.endsWith('_SELF'))return{kind:'self'};if(typ.endsWith('_ATTRIBUTE'))return{kind:'attribute',id:t.cardAttributeType,count:Number(t.targetCount||1)};if(typ.endsWith('_CHARACTER_GROUPING'))return{kind:'group',id:t.characterGroupingId,count:Number(t.targetCount||0)};return{kind:'unsupported',type:typ};};
  const parseSelfTrigger=text=>{const m=String(text||'').match(/^With\s+(\d+)\s+or more\s+(.+?)\s+Members,/i);if(!m)throw new Error(`Cannot parse self-passive trigger: ${text}`);const count=Number(m[1]),rawLabel=m[2],am=rawLabel.match(/\[attribute=([^\]]+)\]/i);if(am){const id=attrByMarkup[am[1].toLowerCase()];if(!id)throw new Error(`Unknown passive attribute ${am[1]} in: ${text}`);return{kind:'attribute',id,count};}const label=stripMarkup(rawLabel),id=groupByLabel.get(label.toLowerCase());if(!id)throw new Error(`Unknown passive group ${label} in: ${text}`);return{kind:'group',id,count};};
  const passiveKind=typ=>typ.endsWith('PERFORMANCE_UP_PERMIL_UP')?'perf':typ.endsWith('TECHNIQUE_UP_PERMIL_UP')?'tech':typ.endsWith('SENSE_UP_PERMIL_UP')?'sense':typ.endsWith('ALL_PARAMETER_UP_PERMIL_UP')?'all':typ.endsWith('LIVE_ACTIVE_SKILL_EFFECT_UP_PERMIL_UP')?'support':'unsupported';
  const scoreValue=e=>{const typ=e.type||'';return typ.endsWith('SCORE_UP_PERMIL_UP')||typ.endsWith('SCORE_UP_EFFECT_UP_PERMIL_UP')?Number(e.value||0)/10:null;};
  const sarValue=e=>(e.type||'').endsWith('LIVE_ACTIVE_SKILL_ACTIVATION_PROBABILITY_UP_PERMIL_UP')?Number(e.value||0)/1000:0;
  const activeLevel=x=>{const base=activeEffect.get(x.liveActiveSkillEffectGroupId),baseMagnitude=scoreValue(base);if(baseMagnitude===null)throw new Error(`Unsupported card Active primary effect ${base?.type}`);let conditionalMagnitude=null,trigger=null;if(x.additionalLiveActiveSkillEffectGroupId){const e=activeEffect.get(x.additionalLiveActiveSkillEffectGroupId);conditionalMagnitude=scoreValue(e);if(conditionalMagnitude===null)throw new Error(`Unsupported card Active additional effect ${e?.type}`);trigger=normalizeTrigger(triggerRows.get(x.additionalLiveSkillTriggerGroupId));}const probability=Number(x.activationProbabilityPermilMultiply)/1000,chanceLabel=Math.abs(probability-.55)<1e-9?'H':Math.abs(probability-.46)<1e-9?'M':Math.abs(probability-.37)<1e-9?'L':`${(probability*100).toFixed(1)}%`;return{level:Number(x.level),baseMagnitude,conditionalMagnitude,trigger,duration:Number(x.effectDurationMillisecond||0)/1000,interval:Number(x.coolTimeMillisecond)/1000,probability,chanceLabel,text:stripMarkup(langActive.get(x.descriptionLangId)||'')};};
  const passiveLevel=x=>{const e=passiveEffect.get(x.livePassiveSkillEffectGroupId),target=normalizeTarget(targets.get(e.liveSkillEffectTargetId)),kind=passiveKind(e.type);if(kind==='unsupported')throw new Error(`Unsupported card Passive effect ${e.type}`);const text=langPassive.get(x.descriptionLangId)||'';let trigger=null;if(target.kind==='self')trigger=parseSelfTrigger(text);else if(target.kind==='attribute'||target.kind==='group')trigger={kind:target.kind,id:target.id,count:target.count||1};return{level:Number(x.level),kind,pct:Number(e.value)/1000,target,trigger,text:stripMarkup(text)};};
  const specialLevel=x=>{const base=activeEffect.get(x.liveActiveSkillEffectGroupId),magnitude=scoreValue(base);if(magnitude===null)throw new Error(`Unsupported card Special primary effect ${base?.type}`);let sarPct=0,sarTrigger=null;const unsupported=[];if(x.additionalLiveActiveSkillEffectGroupId){const e=activeEffect.get(x.additionalLiveActiveSkillEffectGroupId);sarPct=sarValue(e);if(sarPct)sarTrigger=normalizeTrigger(triggerRows.get(x.additionalLiveSkillTriggerGroupId));else unsupported.push({type:e.type,value:e.value??null});}return{level:Number(x.level),magnitude,duration:Number(x.effectDurationMillisecond||0)/1000,sarPct,sarTrigger,unsupported,text:stripMarkup(langSpecial.get(x.descriptionLangId)||'')};};
  const normalizeLeader=cardId=>{const l=leaders.get(`live_leader_skill-${cardId}`);if(!l)throw new Error(`Missing Leader/Outfit for ${cardId}`);const effects=[];for(const [ef,tf] of [['livePassiveSkillEffectGroupId','liveSkillTriggerGroupId'],['additionalLivePassiveSkillEffectGroupId','additionalLiveSkillTriggerGroupId']]){const gid=l[ef];if(!gid)continue;const e=passiveEffect.get(gid),kind=passiveKind(e.type),target=normalizeTarget(targets.get(e.liveSkillEffectTargetId));if(kind==='unsupported'||target.kind!=='all')throw new Error(`Unsupported Leader effect ${e.type} / ${target.kind}`);effects.push({kind,pct:Number(e.value)/1000,trigger:normalizeTrigger(triggerRows.get(l[tf]))});}return{effects,text:stripMarkup(langLeader.get(l.descriptionLangId)||'')};};
  const bloomStages=groupId=>{const arr=potentialByGroup.get(groupId);if(!arr||arr.length!==5)throw new Error(`Expected five Bloom rows for ${groupId}`);const by=new Map(arr.map(x=>[Number(x.upgradeCount),x]));let statBonus=0,activeLevelNo=1,passiveLevelNo=1,specialLevelNo=1,connectLevel=1;const out=[{stage:0,statBonus:0,activeLevel:1,passiveLevel:1,specialLevel:1,connectLevel:1}];for(let stage=1;stage<=5;stage++){const x=by.get(stage),typ=x.effectType||'',value=Number(x.value);if(typ.endsWith('ALL_PARAMETER_UP_PERMIL_UP'))statBonus+=value/1000;else if(typ.endsWith('ACTIVE_SKILL_LEVEL_UP'))activeLevelNo=value;else if(typ.endsWith('PASSIVE_SKILL_LEVEL_UP'))passiveLevelNo=value;else if(typ.endsWith('SPECIAL_SKILL_LEVEL_UP'))specialLevelNo=value;else if(typ.endsWith('SKILL_TREE_CONNECT_EFFECT_LEVEL_UP'))connectLevel=value;else throw new Error(`Unknown Bloom effect ${typ}`);out.push({stage,statBonus,activeLevel:activeLevelNo,passiveLevel:passiveLevelNo,specialLevel:specialLevelNo,connectLevel});}return out;};
  const normalized=[];
  for(const c of cards){const ch=chars.get(c.characterId);if(!ch)throw new Error(`Missing character ${c.characterId}`);const rarity=rarityInt(c.rarity),levelMap=levelByGroup.get(c.cardLevelGroupId);if(!levelMap)throw new Error(`Missing CardLevel group ${c.cardLevelGroupId}`);const maxLevel=Math.max(...levelMap.keys()),levelBaseValues=[];for(let level=1;level<=maxLevel;level++){if(!levelMap.has(level))throw new Error(`Missing ${c.cardLevelGroupId} level ${level}`);levelBaseValues.push(levelMap.get(level));}const al=activeLevels.get(c.liveActiveSkillId),pl=passiveLevels.get(c.livePassiveSkillId),sl=specialLevels.get(c.liveSpecialSkillId);if(!al?.has(1)||!al?.has(2)||!pl?.has(1)||!pl?.has(2)||!sl?.has(1)||!sl?.has(2))throw new Error(`Missing Lv1/Lv2 skill data for ${c.id}`);const gids=[...(charGroupIds.get(c.characterId)||[])].sort();normalized.push({id:c.id,assetId:c.assetId||null,characterId:c.characterId,member:ch.nameEng,name:langCard.get(c.nameLangId)||c.id,key:`${ch.nameEng} | ${langCard.get(c.nameLangId)||c.id}`,rarity,attributeId:c.attributeType,attribute:ATTR_LABEL[c.attributeType]||c.attributeType,groupIds:gids,groupLabels:gids.map(g=>groupLabels[g]||g),maxLevel,levelBaseValues,statPermil:[Number(c.performancePermilMultiply),Number(c.techniquePermilMultiply),Number(c.sensePermilMultiply)],levelLimitCaps:[...(limitByGroup.get(c.cardLevelLimitGroupId)||[])],bloomStages:bloomStages(c.cardPotentialGroupId),activeLevels:{'1':activeLevel(al.get(1)),'2':activeLevel(al.get(2))},passiveLevels:{'1':passiveLevel(pl.get(1)),'2':passiveLevel(pl.get(2))},specialLevels:{'1':specialLevel(sl.get(1)),'2':specialLevel(sl.get(2))},outfit:normalizeLeader(c.id)});}
  const counts={};for(const c of normalized){const k=`${c.rarity}★`;counts[k]=(counts[k]||0)+1;}
  const master={schemaVersion:2,source:'HolodoriDB/holodori-db-eng-diff',sourceVersion:String(sourceVersion||'unknown').trim(),cards:normalized,groupLabels,attributeLabels:ATTR_LABEL,counts};validateMaster(master);return master;
}
function validateMaster(master){if(!master||![1,2].includes(master.schemaVersion)||!Array.isArray(master.cards)||master.cards.length<100)throw new Error('Normalized HolodoriDB snapshot is incomplete.');const ids=new Set();let five=0;for(const c of master.cards){if(!c.id||ids.has(c.id))throw new Error(`Duplicate or missing card id: ${c.id}`);ids.add(c.id);if(c.rarity===5)five++;if(!c.characterId||![3,4,5].includes(c.rarity)||!c.maxLevel||!Array.isArray(c.levelBaseValues)||c.levelBaseValues.length!==c.maxLevel||!Array.isArray(c.bloomStages)||c.bloomStages.length!==6||!c.activeLevels?.['1']||!c.activeLevels?.['2']||!c.passiveLevels?.['1']||!c.passiveLevels?.['2']||!c.specialLevels?.['1']||!c.specialLevels?.['2']||!c.outfit)throw new Error(`Invalid normalized card: ${c.id}`);}if(five<50)throw new Error('Normalized snapshot has too few 5-star cards.');return master;}
function materializeCard(c,level=c.maxLevel,bloom=0,keyOverride=null,boardActiveFrequencyNodes=0){level=Math.max(1,Math.min(c.maxLevel,Math.round(Number(level)||c.maxLevel)));bloom=Math.max(0,Math.min(5,Math.round(Number(bloom)||0)));const stage=c.bloomStages[bloom],base=c.levelBaseValues[level-1],mult=1+stage.statBonus;const stats=c.statPermil.map(p=>Math.ceil(base*p/1000*mult)),active=structuredClone(c.activeLevels[String(stage.activeLevel)]),passive=structuredClone(c.passiveLevels[String(stage.passiveLevel)]),special=structuredClone(c.specialLevels[String(stage.specialLevel)]);const boardNodes=Math.max(0,Math.min(3,Math.round(Number(boardActiveFrequencyNodes)||0))),boardPct=boardNodes*4;if(active&&Number(active.interval)>0){active.baseInterval=Number(active.interval);active.boardActiveFrequencyNodes=boardNodes;active.boardActiveFrequencyPct=boardPct;if(boardNodes>0)active.interval=active.baseInterval*(1-boardPct/100);}return{id:c.id,assetId:c.assetId||null,key:keyOverride||c.id,displayKey:`${c.rarity}★ ${c.member} | ${c.name}`,member:c.member,skin:c.name,characterId:c.characterId,rarity:c.rarity,attributeId:c.attributeId,type:c.attribute,groupIds:[...c.groupIds],generation:c.groupLabels.join(' / '),perf:stats[0],tech:stats[1],sense:stats[2],total:stats[0]+stats[1]+stats[2],level,bloom,maxLevel:c.maxLevel,boardActiveFrequencyNodes:boardNodes,boardActiveFrequencyPct:boardPct,passive,outfit:structuredClone(c.outfit),active,special};}

function chooseCount(n,k){if(k<0||n<k)return 0;k=Math.min(k,n-k);let v=1;for(let i=1;i<=k;i++)v=v*(n-k+i)/i;return Math.round(v);}
function poolAllowsCard(c){return $('cardpool')?.value==='all'||c.rarity===5;}
function currentPoolCards(cards=MASTER_DB.cards){return cards.filter(poolAllowsCard);}
function validTeamCombinationCount(cards,k=5){const mult=new Map();for(const c of cards)mult.set(c.characterId,(mult.get(c.characterId)||0)+1);const dp=Array(k+1).fill(0);dp[0]=1;for(const m of mult.values())for(let j=k;j>=1;j--)dp[j]+=dp[j-1]*m;return Math.round(dp[k]);}
function stars(n){return `${n}★`;}
function baseCardLabel(c){return `${stars(c.rarity)} ${c.member} | ${c.name}`;}
function cardSearchText(c){return `${c.member} ${c.name} ${c.attribute} ${c.rarity} ${c.groupLabels.join(' ')}`.toLowerCase();}
function canonLegacy(s){return String(s||'').normalize('NFKC').replace(/[’‘]/g,"'").replace(/\s+/g,' ').trim().toLowerCase();}
function masterCard(id){return MASTER_CARD_BY_ID.get(id);}
const DEFAULT_BLOOM=0;
function defaultProgress(c){return{owned:false,level:c.maxLevel,bloom:DEFAULT_BLOOM};}
function getOwnedEntry(id){const c=masterCard(id);if(!c)return null;const e=OWNED_PROGRESS.get(id)||defaultProgress(c);return{owned:Boolean(e.owned),level:Math.max(1,Math.min(c.maxLevel,Math.round(Number(e.level)||c.maxLevel))),bloom:Math.max(0,Math.min(5,Math.round(Number(e.bloom)||0)))};}
function setOwnedEntry(id,patch){const c=masterCard(id);if(!c)return;const cur=getOwnedEntry(id);const next={...cur,...patch};next.level=Math.max(1,Math.min(c.maxLevel,Math.round(Number(next.level)||c.maxLevel)));next.bloom=Math.max(0,Math.min(5,Math.round(Number(next.bloom)||0)));next.owned=Boolean(next.owned);OWNED_PROGRESS.set(id,next);}
function saveOwnedProgress(){try{localStorage.setItem(OWNED_PROGRESS_KEY,JSON.stringify(Object.fromEntries(OWNED_PROGRESS)));}catch(_){} }
function loadOwnedProgress(){
  OWNED_PROGRESS=new Map();let loaded=false;
  try{const raw=localStorage.getItem(OWNED_PROGRESS_KEY);if(raw){const obj=JSON.parse(raw);for(const [id,v] of Object.entries(obj))if(MASTER_CARD_BY_ID.has(id))setOwnedEntry(id,v);loaded=true;}}catch(_){}
  if(!loaded){
    try{
      const old=JSON.parse(localStorage.getItem(LEGACY_OWNED_KEY)||'null');
      if(Array.isArray(old)){
        const exact=new Map(),withoutSummer=new Map();
        for(const c of MASTER_DB.cards){exact.set(canonLegacy(c.key),c.id);withoutSummer.set(canonLegacy(`${c.member} | ${c.name}`),c.id);}
        for(const key of old){let id=exact.get(canonLegacy(key));if(!id&&/^summer\s+/i.test(key)){id=withoutSummer.get(canonLegacy(key.replace(/^Summer\s+/i,'')));}if(id){const c=masterCard(id);OWNED_PROGRESS.set(id,{owned:true,level:c.maxLevel,bloom:DEFAULT_BLOOM});}}
      }
    }catch(_){}
  }
  reconcileOwnedProgress();saveOwnedProgress();OWNERSHIP_LOADED=true;
}
function reconcileOwnedProgress(){const next=new Map();for(const [id,v] of OWNED_PROGRESS){const c=masterCard(id);if(!c)continue;next.set(id,{owned:Boolean(v.owned),level:Math.max(1,Math.min(c.maxLevel,Math.round(Number(v.level)||c.maxLevel))),bloom:Math.max(0,Math.min(5,Math.round(Number(v.bloom)||0)))});}OWNED_PROGRESS=next;}
function allOwnedIds(){return MASTER_DB.cards.filter(c=>getOwnedEntry(c.id).owned).map(c=>c.id);}
function optimizerEffectiveCards(useOwnedProgress,forcedOutfitId=null,{unownedAtDefault=false}={}){return MASTER_DB.cards.map(c=>{const e=getOwnedEntry(c.id),p=useOwnedProgress&&(!unownedAtDefault||e.owned)?e:defaultProgress(c);return materializeCard(c,p.level,p.bloom);});}
function workerSourceFor(cards){return WORKER_TEMPLATE.replace('__CARDS__',JSON.stringify(cards));}
function makeWorker(cards){return new Worker(URL.createObjectURL(new Blob([workerSourceFor(cards)],{type:'text/javascript'})));}
function workerCardsSignature(cards,kind='optimizer'){const rows=cards.map(c=>`${c.key}|${c.id}|${c.level}|${c.bloom}|${c.total}|${Number(c.active?.interval)||0}|${Number(c.boardActiveFrequencyNodes)||0}`).join('~');return `${kind}|${String(MASTER_DB?.sourceVersion||'unknown')}|${rows}`;}
function acquireOptimizerWorker(cards){const sig=workerCardsSignature(cards,'optimizer'),reused=Boolean(worker&&workerSignature===sig);if(!reused){if(worker)worker.terminate();worker=makeWorker(cards);workerSignature=sig;}return{instance:worker,reused};}
function acquireComparisonWorker(cards){const sig=workerCardsSignature(cards,'comparison'),reused=Boolean(compareWorker&&compareWorkerSignature===sig);if(!reused){if(compareWorker)compareWorker.terminate();compareWorker=makeWorker(cards);compareWorkerSignature=sig;}return{instance:compareWorker,reused};}
function discardOptimizerWorker(){if(worker)worker.terminate();worker=null;workerSignature='';}
function discardComparisonWorker(){if(compareWorker)compareWorker.terminate();compareWorker=null;compareWorkerSignature='';}

function showDbMessage(message,isError=true){const box=$('dberror');if(!message){box.style.display='none';box.textContent='';return;}box.style.display='block';box.className=isError?'dberror':'dberror dbsuccess';box.textContent=message;}
function downloadText(name,text,type){const a=document.createElement('a');a.href=URL.createObjectURL(new Blob([text],{type}));a.download=name;a.click();setTimeout(()=>URL.revokeObjectURL(a.href),1000);}
function validateAndApplyMaster(master,source,{saveCache=false}={}){
  validateMaster(master);MASTER_DB=structuredClone(master);MASTER_CARD_BY_ID=new Map(MASTER_DB.cards.map(c=>[c.id,c]));DATA_SOURCE=source;reconcileOwnedProgress();populateDatabaseSelectors();renderOwnedCards();updateDbStatus();clearRunResults();syncSearchMode();
  if(saveCache){try{localStorage.setItem(MASTER_CACHE_KEY,JSON.stringify(MASTER_DB));}catch(e){showDbMessage(`Database update loaded, but could not be cached: ${e.message}`,true);}}
}
function loadCachedMaster(){try{const raw=localStorage.getItem(MASTER_CACHE_KEY);if(!raw)return false;const m=JSON.parse(raw);validateAndApplyMaster(m,'Cached HolodoriDB update',{saveCache:false});return true;}catch(e){try{localStorage.removeItem(MASTER_CACHE_KEY);}catch(_){}return false;}}
function updateDbStatus(){const counts=MASTER_DB.counts||{};const five=MASTER_DB.cards.filter(c=>c.rarity===5).length;const ver=String(MASTER_DB.sourceVersion||'unknown').slice(0,10);$('dbstatus').textContent=`${DATA_SOURCE} · ${MASTER_DB.cards.length} cards (${counts['5★']||five} 5★ / ${counts['4★']||0} 4★ / ${counts['3★']||0} 3★) · data ${ver}`;const bp=$('buildpipeline');if(bp)bp.textContent=`App ${BUILD_INFO.appVersion} · scoring ${BUILD_INFO.scoringModelVersion} · chart r${BUILD_INFO.chartAssetRevision} / ${BUILD_INFO.chartPackSchemaVersion} · cards ${String(BUILD_INFO.sourceVersion||'unknown').slice(0,10)}`;}
async function fetchWithTimeout(url,{json=false,timeout=15000}={}){const controller=new AbortController();const timer=setTimeout(()=>controller.abort(),timeout);try{const r=await fetch(url,{cache:'no-store',signal:controller.signal});if(!r.ok)throw new Error(`${r.status} ${r.statusText}`);return json?r.json():r.text();}finally{clearTimeout(timer);}}
async function checkDatabaseUpdate({silent=false,force=false}={}){
  if(updateController)updateController.abort();updateController=new AbortController();const button=$('dbupdate');if(button)button.disabled=true;
  if(!silent)showDbMessage('Checking HolodoriDB for updates…',false);
  try{
    const version=String(await fetchWithTimeout(HOLODORI_RAW_BASE+'version.txt',{timeout:10000})).trim();
    if(!force&&version===MASTER_DB.sourceVersion){if(!silent)showDbMessage('HolodoriDB is already up to date.',false);return;}
    if(!silent)showDbMessage(`New HolodoriDB data found (${version.slice(0,10)}). Downloading and validating…`,false);
    const raw={};let done=0;
    const queue=[...HOLODORI_RAW_FILES];
    async function runner(){while(queue.length){const name=queue.shift();raw[name]=await fetchWithTimeout(HOLODORI_RAW_BASE+name,{json:true,timeout:20000});done++;if(!silent)$('dbstatus').textContent=`Downloading HolodoriDB… ${done}/${HOLODORI_RAW_FILES.length}`;}}
    await Promise.all(Array.from({length:Math.min(6,queue.length)},()=>runner()));
    const master=normalizeHolodoriRaw(raw,version);validateAndApplyMaster(master,'Live HolodoriDB',{saveCache:true});showDbMessage(`Updated successfully to HolodoriDB ${version.slice(0,10)}.`,false);
  }catch(e){if(!silent)showDbMessage(`Could not update from HolodoriDB. The current validated snapshot remains active. ${e.message||e}`,true);updateDbStatus();}
  finally{if(button)button.disabled=false;updateController=null;}
}
function useBundledFallback(){try{localStorage.removeItem(MASTER_CACHE_KEY);}catch(_){}validateAndApplyMaster(BUNDLED_MASTER,'Bundled fallback',{saveCache:false});showDbMessage('Using the bundled last-known-good HolodoriDB snapshot.',false);}

function validateChartSnapshot(snapshot,{allowPacked=false}={}){
  if(!snapshot||Number(snapshot.schemaVersion)!==1||!Array.isArray(snapshot.charts)||!snapshot.charts.length)throw new Error('Chart snapshot is missing schemaVersion 1 or chart rows.');
  const keys=new Set();for(const c of snapshot.charts){if(!c.key||keys.has(c.key))throw new Error(`Duplicate or missing chart key: ${c.key||'(missing)'}`);keys.add(c.key);if(!c.musicId||!c.difficultyType||!c.chartAssetId)throw new Error(`Invalid chart metadata: ${c.key}`);if(c.timelineAvailable){if(c.timelinePacked){if(!allowPacked||!CHART_PACK?.index?.[c.key])throw new Error(`Packed timeline is only valid for the bundled release companion: ${c.key}`);continue;}if(!Array.isArray(c.notes)||!c.notes.length||!Array.isArray(c.specialTimesMs)||c.specialTimesMs.length!==5)throw new Error(`Incomplete timeline: ${c.key}`);let last=-1,total=0;for(const row of c.notes){if(!Array.isArray(row)||row.length<2)throw new Error(`Invalid note row: ${c.key}`);const t=Number(row[0]),w=Number(row[1]);if(!Number.isFinite(t)||t<last||!Number.isFinite(w)||w<=0)throw new Error(`Invalid note timeline: ${c.key}`);last=t;total+=w;}if(c.fullComboNoteCount&&c.notes.length!==Number(c.fullComboNoteCount))throw new Error(`Timeline note count does not match DB full combo: ${c.key}`);if(!(total>0))throw new Error(`Timeline weight is empty: ${c.key}`);}}
  return snapshot;
}
function chartTimelineCount(){return (CHART_DB?.charts||[]).filter(c=>c.timelineAvailable).length;}
function chartForSelectors(songId,difficultyId){const mid=$(songId)?.value,diff=Number($(difficultyId)?.value);return (CHART_DB?.charts||[]).find(c=>c.musicId===mid&&Number(c.difficultyType)===diff)||null;}
function currentChart(){return chartForSelectors('chartsong','chartdifficulty');}
function currentCompareChart(){return chartForSelectors('compare-chartsong','compare-chartdifficulty');}
function populateChartSelectorPair(songId,difficultyId,statusFn){if(!CHART_DB)return;const songSel=$(songId),diffSel=$(difficultyId);if(!songSel||!diffSel)return;const oldSong=songSel.value,oldDiff=diffSel.value,bySong=new Map();for(const c of CHART_DB.charts){if(!bySong.has(c.musicId))bySong.set(c.musicId,{musicId:c.musicId,title:c.title,ready:false});if(c.timelineAvailable)bySong.get(c.musicId).ready=true;}const songs=[...bySong.values()].sort((a,b)=>a.title.localeCompare(b.title,'en-US')||a.musicId.localeCompare(b.musicId));songSel.innerHTML='';for(const x of songs){const o=document.createElement('option');o.value=x.musicId;o.textContent=x.title;songSel.appendChild(o);}if(songs.some(x=>x.musicId===oldSong&&(x.ready||!songs.some(y=>y.ready))))songSel.value=oldSong;else{const preferred=songs.find(x=>x.ready)||songs[0];if(preferred)songSel.value=preferred.musicId;}const diffs=CHART_DB.charts.filter(c=>c.musicId===songSel.value).sort((a,b)=>a.difficultyType-b.difficultyType);diffSel.innerHTML='';for(const c of diffs){const o=document.createElement('option');o.value=String(c.difficultyType);o.textContent=`${c.difficulty} · Lv${c.difficultyLevel}${c.timelineAvailable?'':' · exact unavailable'}`;diffSel.appendChild(o);}if(diffs.some(c=>String(c.difficultyType)===oldDiff&&c.timelineAvailable))diffSel.value=oldDiff;else{const preferred=[...diffs].reverse().find(c=>c.timelineAvailable)||diffs[diffs.length-1];if(preferred)diffSel.value=String(preferred.difficultyType);}statusFn();}
function populateChartSelectors(){populateChartSelectorPair('chartsong','chartdifficulty',updateChartStatus);}
function populateCompareChartSelectors(){populateChartSelectorPair('compare-chartsong','compare-chartdifficulty',updateCompareChartStatus);}
function songJacketUrl(musicId){const id=String(musicId||'').trim();return id?`https://api.holodori.best/api/asset/assetbundles/img_music_jacket_${encodeURIComponent(id)}/img_music_jacket_${encodeURIComponent(id)}.webp?rev=51`:'';}
function setSongJacket(id,c){const img=$(id);if(!img)return;const url=c?songJacketUrl(c.musicId):'';if(!url){img.removeAttribute('src');img.style.visibility='hidden';return;}img.style.visibility='visible';img.classList.remove('image-failed');img.onerror=()=>img.classList.add('image-failed');img.src=url;}
function chartStatusHtml(c){return c.timelineAvailable?`<b>${escapeHtml(c.difficulty)} · Lv${c.difficultyLevel}</b><span class="chart-pill">FC ${Number(c.fullComboNoteCount||c.notes?.length||0).toLocaleString(NUMBER_LOCALE)}</span><span class="chart-pill">${fmt(c.beatmapSeconds||c.playingSeconds||0,0)} s</span>`:`<b>${escapeHtml(c.difficulty)} · Lv${c.difficultyLevel}</b><br>Exact timeline unavailable for this difficulty; choose another difficulty or use Any song.`;}
function setChartStatus(box,c){if(!box)return;setSongJacket(box.id==='compare-chartstatus'?'compare-chartjacket':'chartjacket',c);if(!c){box.className='chart-status warn';box.textContent='No chart selected.';return;}box.className=`chart-status ${c.timelineAvailable?'ready':'warn'}`;box.innerHTML=chartStatusHtml(c);}
function updateChartStatus(){const c=currentChart(),count=chartTimelineCount(),meta=CHART_DB?.charts?.length||0,status=$('chartdbstatus');if(status)status.textContent=`${CHART_SOURCE}: ${meta} song+difficulty metadata rows · ${count} validated note timelines · source ${String(CHART_DB?.sourceVersion||'unknown').slice(0,10)}`;setChartStatus($('chartstatus'),c);syncScoringMode();}
function updateCompareChartStatus(){setChartStatus($('compare-chartstatus'),currentCompareChart());}
function syncModeButtons(groupId,mode){const host=$(groupId);if(!host)return;for(const b of host.querySelectorAll('button[data-mode],button[data-pool],button[data-board-mode]')){const value=b.dataset.mode??b.dataset.pool??b.dataset.boardMode;const active=value===mode;b.classList.toggle('active',active);b.setAttribute('aria-pressed',active?'true':'false');}}
function setOptimizerScoringMode(mode){$('scoringmode').value=mode;syncScoringMode();}
function setComparisonScoringMode(mode){$('compare-scoringmode').value=mode;syncCompareScoringMode();}
function syncScoringMode(){const chartMode=$('scoringmode')?.value==='chart';if($('chartcontrols'))$('chartcontrols').style.display=chartMode?'block':'none';if($('genericcontrols'))$('genericcontrols').style.display='none';syncModeButtons('scoring-mode-toggle',chartMode?'chart':'generic');const help=$('scoringmodehelp');if(help)help.innerHTML=chartMode?'Using the selected song and difficulty.':'Optimizes for strong performance across songs rather than one specific chart.';if(chartMode)updateChartStatusNoSync();syncQuickDefaults();}
function updateBoardNodeUi(){const slider=$('board-frequency-nodes'),out=$('board-frequency-nodes-value');if(!slider||!out)return;const n=Math.max(0,Math.min(12,Math.round(+slider.value||0)));slider.value=String(n);out.textContent=`${n} / 12 nodes`;syncQuickDefaults();}
function syncBoardMode(){const optimize=$('boardmode')?.value==='optimize';syncModeButtons('board-mode-toggle',optimize?'optimize':'off');if($('board-node-control'))$('board-node-control').hidden=!optimize;updateBoardNodeUi();}
function setBoardMode(mode){if($('boardmode'))$('boardmode').value=mode==='optimize'?'optimize':'off';syncBoardMode();}
function updateChartStatusNoSync(){setChartStatus($('chartstatus'),currentChart());}
function syncCompareScoringMode(){const chartMode=$('compare-scoringmode')?.value==='chart';if($('compare-chartcontrols'))$('compare-chartcontrols').style.display=chartMode?'block':'none';if($('compare-genericcontrols'))$('compare-genericcontrols').style.display='none';syncModeButtons('compare-scoring-mode-toggle',chartMode?'chart':'generic');const help=$('compare-scoringmodehelp');if(help)help.textContent=chartMode?'Choose a song uses the exact selected Perfect-FC timeline.':'Any song uses the calibrated average-chart model for chart-agnostic comparison.';if(chartMode)updateCompareChartStatus();}
function applyChartSnapshot(snapshot,source,{allowPacked=false}={}){validateChartSnapshot(snapshot,{allowPacked});CHART_DB=structuredClone(snapshot);CHART_SOURCE=source;CHART_MATERIALIZED.clear();const hasCharts=chartTimelineCount()>0,mode=$('scoringmode'),compareMode=$('compare-scoringmode');if(!hasCharts){if(mode)mode.value='generic';if(compareMode)compareMode.value='generic';}populateChartSelectors();populateCompareChartSelectors();syncScoringMode();syncCompareScoringMode();}
async function importChartSnapshot(file){const text=await file.text(),snapshot=JSON.parse(text);applyChartSnapshot(snapshot,'Imported chart snapshot');}

function cardInitials(card){const words=String(card?.member||card?.name||'?').trim().split(/\s+/).filter(Boolean);return (words.slice(0,2).map(x=>x[0]).join('')||'?').toUpperCase();}
function cardImageUrl(card){const id=String(card?.assetId||'').trim();if(!id)return'';return `${CARD_IMAGE_BASE}img_card_full_${encodeURIComponent(id)}/img_card_full_${encodeURIComponent(id)}.webp`;}
function cardPortraitUrl(card){const id=String(card?.assetId||'').trim();if(!id)return'';const e=encodeURIComponent(id);return `${CARD_IMAGE_BASE}img_card_vert_${e}/img_card_vert_${e}.webp?rev=${CARD_ASSET_REV}`;}
function cardRarityBannerUrl(card){const rarity=Number(card?.rarity||0);return rarity>=3&&rarity<=5?`${CARD_MANUAL_ASSET_BASE}card-rarity-${rarity}.webp`:'';}
function cardAttributeUrl(card){const key=String(card?.attribute||'').trim().toLowerCase();return ['happy','pure','cute'].includes(key)?`${CARD_MANUAL_ASSET_BASE}attr-${key}.webp`:'';}
function cardRarityStarsHtml(card){const rarity=Math.max(0,Math.min(5,Number(card?.rarity||0)));if(rarity<1)return'';const src=`${CARD_MANUAL_ASSET_BASE}rarity-star-animated.webp`;return `<span class="ct-stars" aria-hidden="true">${Array.from({length:rarity},(_,i)=>`<img class="ct-star" alt="" src="${escapeHtml(src)}" loading="lazy" decoding="async" referrerpolicy="no-referrer" onerror="this.remove()">`).join('')}</span>`;}
function cardArtHtml(card,className='',loading='lazy'){
  const initials=escapeHtml(cardInitials(card)),label=escapeHtml(card?`${card.member} — ${card.name}`:'Card artwork');
  if(!CARD_ART_ENABLED||!card)return `<span class="card-art-frame ${escapeHtml(className)}"><span class="card-art-fallback" aria-hidden="true">${initials}</span></span>`;
  const portrait=cardPortraitUrl(card),full=cardImageUrl(card),banner=cardRarityBannerUrl(card),attr=cardAttributeUrl(card);
  if(!portrait)return `<span class="card-art-frame ${escapeHtml(className)}"><span class="card-art-fallback" aria-hidden="true">${initials}</span></span>`;
  const artError=`if(this.dataset.fallback!=='1'){this.dataset.fallback='1';this.src='${escapeHtml(full)}';}else{this.closest('.card-art-frame').classList.add('image-failed');this.remove();}`;
  return `<span class="card-art-frame ${escapeHtml(className)}"><span class="card-art-fallback" aria-hidden="true">${initials}</span><span class="ct-wrap"><span class="ct-card"><img class="ct-art" alt="${label}" src="${escapeHtml(portrait)}" loading="${loading}" decoding="async" referrerpolicy="no-referrer" onerror="${artError}">${banner?`<img class="ct-banner" alt="" src="${escapeHtml(banner)}" loading="lazy" decoding="async" referrerpolicy="no-referrer" aria-hidden="true" onerror="this.remove()">`:''}</span><span class="ct-stroke" aria-hidden="true"></span>${cardRarityStarsHtml(card)}${attr?`<img class="ct-attr" alt="" src="${escapeHtml(attr)}" loading="lazy" decoding="async" referrerpolicy="no-referrer" aria-hidden="true" onerror="this.remove()">`:''}</span></span>`;
}
function selectionPreviewHtml(card,{outfit=false}={}){if(!card)return'<span class="tiny">No card selected.</span>';const groups=card.groupLabels?.join(' / ')||'No group';return `${cardArtHtml(card)}<div class="selection-preview-copy"><b>${escapeHtml(card.member)}</b><span>${escapeHtml(card.name)}</span><small>${escapeHtml(stars(card.rarity))} · ${escapeHtml(card.attribute)} · ${escapeHtml(groups)}${outfit?` · ${escapeHtml(compactOutfitText(card.outfit?.text||''))}`:''}</small></div>`;}
function updateSelectionPreviews(){const a=masterCard($('anchor')?.value),o=masterCard($('outfitpick')?.value);if($('anchorpreview'))$('anchorpreview').innerHTML=selectionPreviewHtml(a);if($('outfitpreview'))$('outfitpreview').innerHTML=selectionPreviewHtml(o,{outfit:true});}
function setArtworkEnabled(enabled,{persist=true}={}){CARD_ART_ENABLED=Boolean(enabled);if(persist){try{localStorage.setItem(ARTWORK_PREF_KEY,CARD_ART_ENABLED?'1':'0');}catch(_){}}const t=$('artworktoggle');if(t)t.checked=CARD_ART_ENABLED;updateSelectionPreviews();renderOwnedCards();refreshComparisonPreviews();if(lastResults.length)render(lastResults);if(lastComparison)renderComparison(lastComparison);}
function loadArtworkPreference(){try{const v=localStorage.getItem(ARTWORK_PREF_KEY);CARD_ART_ENABLED=v===null?true:v!=='0';}catch(_){CARD_ART_ENABLED=true;}const t=$('artworktoggle');if(t)t.checked=CARD_ART_ENABLED;}
function highestBaseStatLabel(card){if(!card?.statPermil?.length)return'';const [perf,tech,sense]=card.statPermil.map(Number);if(perf>=tech&&perf>=sense)return'Performance';if(sense>=tech)return'Sense';return'Technique';}
function boardPipsHtml(nodes){const n=Math.max(0,Math.min(3,Math.round(Number(nodes)||0)));return `<span class="board-node-pips" aria-label="${n} Frequency Up node${n===1?'':'s'}">${[0,1,2].map(i=>`<span class="board-node-pip ${i<n?'on':'off'}">${i<n?'●':'○'}</span>`).join('')}</span>`;}
function resultCardTile(result,index,{compact=false,loading='lazy'}={}){const id=result.cardIds?.[index],card=id?masterCard(id):null,p=result.cardProgress?.[index],member=card?.member||result.members?.[index]||result.cards?.[index]||'Unknown',name=card?.name||result.cards?.[index]||'',rarity=p?.rarity||card?.rarity||'',statLabel=highestBaseStatLabel(card),boardNodes=Math.max(0,Math.min(3,Math.round(Number(p?.boardFrequencyNodes??p?.boardActiveFrequencyNodes??0)||0))),boardEnabled=boardNodes>0||((typeof $==='function')&&($('boardmode')?.value==='optimize')),outfitCard=result.outfitCard?masterCard(result.outfitCard):null,isLeader=!!(boardEnabled&&card&&outfitCard&&card.characterId===outfitCard.characterId),boardHtml=!boardEnabled?'':isLeader?`<small class="board-allocation leader-board-allocation"><span class="board-allocation-label">Leader Holomem Board</span><span class="leader-board-note">Frequency nodes N/A</span></small>`:`<small class="board-allocation"><span class="board-allocation-label">Frequency Up nodes</span>${boardPipsHtml(boardNodes)}</small>`;return `<div class="team-card-tile" title="Position ${index+1}: ${escapeHtml(member)} — ${escapeHtml(name)}"><div class="team-card-art-shell">${cardArtHtml(card,compact?'compact-art':'',loading)}<span class="team-card-position">${index+1}</span>${rarity?`<span class="team-card-rarity">${escapeHtml(stars(rarity))}</span>`:''}</div><div class="team-card-copy"><b>${escapeHtml(member)}</b><span>${escapeHtml(name)}</span><small>${escapeHtml(statLabel)}${p?` · Lv${p.level} · Bloom ${p.bloom}`:''}</small>${boardHtml}</div></div>`;}
function resultTeamLineup(result,{compact=false,loading='lazy'}={}){return `<div class="team-lineup${compact?' compact':''}">${result.cards.map((_,i)=>resultCardTile(result,i,{compact,loading})).join('')}</div>`;}

function representativeMemberCard(characterId){const cards=MASTER_DB?.cards?.filter(c=>c.characterId===characterId)||[];return cards.sort((a,b)=>b.rarity-a.rarity||a.name.localeCompare(b.name,'en-US'))[0]||null;}
function oshiCardChoices(){if(!MASTER_DB)return[];let cards=MASTER_DB.cards.filter(c=>getOwnedEntry(c.id).owned&&c.rarity>=3&&c.rarity<=5);if(!cards.length)cards=MASTER_DB.cards.filter(c=>c.rarity>=3&&c.rarity<=5);return cards.sort((a,b)=>a.member.localeCompare(b.member,'en-US')||b.rarity-a.rarity||a.name.localeCompare(b.name,'en-US'));}
function fillOshiCardSelect(sel,old=''){if(!sel||!MASTER_DB)return;const cards=oshiCardChoices();sel.innerHTML='';for(const c of cards){const o=document.createElement('option');o.value=c.id;o.textContent=`${stars(c.rarity)} ${c.member} — ${c.name}`;sel.appendChild(o);}if(cards.some(c=>c.id===old))sel.value=old;if(!sel.value&&cards[0])sel.value=cards[0].id;}
function updateOshiCardSelect(){const sel=$('oshi-card-select');if(!sel||!MASTER_DB)return;fillOshiCardSelect(sel,sel.value||$('anchor')?.value||'');updateOshiCardPreview();}
function updateOshiCardPreview(){const c=masterCard($('oshi-card-select')?.value);if($('oshi-card-preview'))$('oshi-card-preview').innerHTML=selectionPreviewHtml(c,{outfit:true});if($('oshi-selected-name'))$('oshi-selected-name').textContent=c?`${c.member} required`:'Choose a card';}
function updateUpgradeOshiCardSelect(){const sel=$('upgrade-oshi-card-select');if(!sel||!MASTER_DB)return;fillOshiCardSelect(sel,sel.value||$('oshi-card-select')?.value||'');updateUpgradeOshiPreview();}
function updateUpgradeOshiPreview(){const c=masterCard($('upgrade-oshi-card-select')?.value);if($('upgrade-oshi-card-preview'))$('upgrade-oshi-card-preview').innerHTML=selectionPreviewHtml(c,{outfit:true});}
function syncUpgradeOshiMode(){if($('upgrade-scope')?.value!=='oshi')return;const c=masterCard($('upgrade-oshi-card-select')?.value);if(!c)return;if(c.rarity<5&&$('cardpool').value!=='all')setCardPool('all');updateUpgradeOshiPreview();}
function setUpgradeScope(scope){scope=scope==='oshi'?'oshi':'any';if($('upgrade-scope'))$('upgrade-scope').value=scope;document.querySelectorAll('#upgrade-scope-toggle button[data-scope]').forEach(b=>b.classList.toggle('active',b.dataset.scope===scope));if($('upgrade-oshi-wrap'))$('upgrade-oshi-wrap').hidden=scope!=='oshi';if(scope==='oshi'){updateUpgradeOshiCardSelect();syncUpgradeOshiMode();}}
function syncQuickDefaults(){const host=document.querySelector('.quick-defaults');if(!host)return;const pool=$('cardpool')?.value==='all'?'All cards':'5★ only',song=$('scoringmode')?.value==='chart'?'Choose a song':'Any song',mode=$('outfitmode')?.value,outfit=mode==='oshi'?"Oshi Outfit":mode==='fixed'?'Chosen Outfit':mode==='any'?'Any owned Outfit':'Team Outfit',boardOn=$('boardmode')?.value==='optimize',board=boardOn?`${Math.max(0,Math.min(12,Math.round(+$('board-frequency-nodes')?.value||0)))} Board nodes`:'Board off';host.innerHTML=`<button type="button" class="quick-chip" data-quick="pool">${escapeHtml(pool)}</button><button type="button" class="quick-chip" data-quick="song">${escapeHtml(song)}</button><button type="button" class="quick-chip" data-quick="outfit">${escapeHtml(outfit)}</button><button type="button" class="quick-chip" data-quick="board">${escapeHtml(board)}</button>`;host.querySelector('[data-quick="pool"]')?.addEventListener('click',()=>setCardPool($('cardpool').value==='all'?'five':'all'));host.querySelector('[data-quick="song"]')?.addEventListener('click',()=>setOptimizerScoringMode($('scoringmode').value==='chart'?'generic':'chart'));host.querySelector('[data-quick="outfit"]')?.addEventListener('click',()=>{const choice=document.querySelector('input[name="outfit-choice"]:checked');choice?.focus();choice?.scrollIntoView({behavior:'smooth',block:'nearest'});});host.querySelector('[data-quick="board"]')?.addEventListener('click',()=>{if($('boardmode')?.value!=='optimize')setBoardMode('optimize');$('board-frequency-nodes')?.focus();$('board-node-control')?.scrollIntoView({behavior:'smooth',block:'nearest'});});}
function setCardPool(value){$('cardpool').value=value==='all'?'all':'five';syncModeButtons('cardpool-toggle',$('cardpool').value);populateDatabaseSelectors();renderOwnedCards();syncSearchMode();updateOshiCardSelect();updateUpgradeOshiCardSelect();syncQuickDefaults();}
function syncQuickOshiMode(){if(!$('goal-oshi')?.classList.contains('active'))return;const id=$('oshi-card-select')?.value,c=masterCard(id);if(!c)return;SELECTED_OSHI_CHARACTER_ID=c.characterId;$('anchor').value=id;$('searchmode').value='anchor';ANCHOR_OWNED_OPTION=true;$('ownedonly').checked=true;if(c.rarity<5&&$('cardpool').value!=='all')setCardPool('all');if($('outfitmode').value==='oshi')$('outfitpick').value=id;updateOshiCardPreview();syncOutfitMode();syncSearchMode();}
function setQuickGoal(goal){const oshi=goal==='oshi',upgrade=goal==='upgrade';$('goal-best').classList.toggle('active',!oshi&&!upgrade);$('goal-oshi').classList.toggle('active',oshi);$('goal-upgrade').classList.toggle('active',upgrade);$('quick-oshi-panel').hidden=!oshi;if($('upgrade-scope-panel'))$('upgrade-scope-panel').hidden=!upgrade;if($('upgrade-assumption'))$('upgrade-assumption').hidden=!upgrade;if(oshi){updateOshiCardSelect();syncQuickOshiMode();$('quickrun').textContent='Find best team around my oshi';if($('outfitmode').value==='best')$('outfitmode').value='oshi';syncOutfitMode();}else{$('searchmode').value='owned';SELECTED_OSHI_CHARACTER_ID='';if($('outfitmode').value==='oshi')$('outfitmode').value='best';syncOutfitMode();syncSearchMode();if(upgrade){updateUpgradeOshiCardSelect();setUpgradeScope($('upgrade-scope')?.value||'any');}$('quickrun').textContent=upgrade?'Find my best next card':'Find my best team';}if($('results-heading'))$('results-heading').textContent=upgrade?'Best next cards':'Your best teams';syncQuickDefaults();}
function initializeQuickUX(){const qi=$('quickimport'),input=$('ownedimportfiles');if(qi&&input){qi.onclick=()=>input.click();for(const ev of ['dragenter','dragover'])qi.addEventListener(ev,e=>{e.preventDefault();qi.classList.add('dragover');});for(const ev of ['dragleave','drop'])qi.addEventListener(ev,e=>{e.preventDefault();qi.classList.remove('dragover');});qi.addEventListener('drop',e=>{if(e.dataTransfer?.files?.length)rosterImportFiles(e.dataTransfer.files);});}$('quickeditroster').onclick=()=>{$('roster-editor').open=true;$('roster-editor').scrollIntoView({behavior:'smooth',block:'nearest'});};$('goal-best').onclick=()=>setQuickGoal('best');$('goal-oshi').onclick=()=>setQuickGoal('oshi');$('goal-upgrade').onclick=()=>setQuickGoal('upgrade');$('oshi-card-select').onchange=syncQuickOshiMode;if($('upgrade-oshi-card-select'))$('upgrade-oshi-card-select').onchange=syncUpgradeOshiMode;document.querySelectorAll('#upgrade-scope-toggle button[data-scope]').forEach(b=>b.onclick=()=>setUpgradeScope(b.dataset.scope));$('quickrun').onclick=()=>{if($('goal-oshi').classList.contains('active')&&!$('oshi-card-select').value){alert('Choose your oshi card first.');return;}if($('goal-upgrade').classList.contains('active')&&$('upgrade-scope')?.value==='oshi'&&!$('upgrade-oshi-card-select')?.value){alert('Choose your oshi card first.');return;}const owned=MASTER_DB.cards.filter(c=>getOwnedEntry(c.id).owned);if(!owned.length){alert('Import or select your roster first.');return;}const eligible=owned.filter(poolAllowsCard),distinct=new Set(eligible.map(c=>c.characterId));if(distinct.size<5&&$('cardpool').value!=='all'){const allDistinct=new Set(owned.filter(c=>c.rarity>=3&&c.rarity<=5).map(c=>c.characterId));if(allDistinct.size>=5)setCardPool('all');}if($('goal-oshi').classList.contains('active'))syncQuickOshiMode();if($('goal-upgrade').classList.contains('active')&&$('upgrade-scope')?.value==='oshi')syncUpgradeOshiMode();$('run').click();};document.querySelectorAll('#cardpool-toggle button[data-pool]').forEach(b=>b.onclick=()=>setCardPool(b.dataset.pool));document.querySelectorAll('#board-mode-toggle button[data-board-mode]').forEach(b=>b.onclick=()=>setBoardMode(b.dataset.boardMode));$('board-frequency-nodes')?.addEventListener('input',updateBoardNodeUi);$('boardmode')?.addEventListener('change',syncBoardMode);document.querySelectorAll('input[name="outfit-choice"]').forEach(r=>r.addEventListener('change',()=>{if(!r.checked)return;$('outfitmode').value=r.value;syncOutfitMode();}));for(const id of ['searchquality','outfitmode','scoringmode','boardmode'])$(id)?.addEventListener('change',syncQuickDefaults);updateQuickRosterSummary();updateOshiCardSelect();updateUpgradeOshiCardSelect();syncBoardMode();setUpgradeScope('any');setQuickGoal('best');}

function outfitSummaryHtml(result){const card=masterCard(result.outfitCard),external=result.outfitExternal?'<span class="external-badge">external card</span>':'';return `${cardArtHtml(card)}<div class="outfit-summary-copy"><span class="eyebrow">Outfit used</span><b>${escapeHtml(result.outfitOwner)}${external}</b><small title="${escapeHtml(result.outfitText)}">${escapeHtml(compactOutfitText(result.outfitText))}${result.outfitTriggered?'':' <span class="outfit-warning">· no effect triggered</span>'}</small></div>`;}
function alternativeOutfitHtml(result){const same=result.outfitCard===result.bestAvailableOutfitCard&&result.outfitPenalty<1e-10;if(same)return'Same as the Outfit used';const card=masterCard(result.bestAvailableOutfitCard),external=result.bestAvailableOutfitExternal?'<span class="external-badge">external card</span>':'';return `<div class="alt-outfit-row">${cardArtHtml(card)}<div><b>${escapeHtml(result.bestAvailableOutfitOwner)}</b>${external}<br>${escapeHtml(result.bestAvailableOutfitText)}${result.bestAvailableOutfitTriggered?'':' <em>(no effect triggered)</em>'}</div></div>`;}
function setComparePreview(side,pos,card){const slot=$(`compare-${side}-${pos}`)?.closest('.compare-slot');if(!slot)return;let host=slot.querySelector('.compare-slot-art');if(!host){host=document.createElement('div');host.className='compare-slot-art';slot.prepend(host);}host.innerHTML=`${cardArtHtml(card)}<span class="team-card-position">${pos}</span>`;}
function refreshComparisonPreviews(){if(!MASTER_DB)return;for(const side of ['a','b'])for(let pos=1;pos<=5;pos++){const sel=$(`compare-${side}-${pos}`);if(sel)setComparePreview(side,pos,masterCard(sel.value));}updateComparisonOutfitNotes();}

function updateQuickRosterSummary(){if(!MASTER_DB)return;const owned=MASTER_DB.cards.filter(c=>getOwnedEntry(c.id).owned),members=new Set(owned.map(c=>c.characterId)),e=$('quickrostersummary');if(e)e.textContent=owned.length?`${owned.length} cards · ${members.size} Holomems`:'No roster imported';const hint=$('quickrosterhint');if(hint)hint.textContent=owned.length?'Roster saved locally · import more screenshots or edit manually.':'Screenshot import assumes max Level by default and keeps detected Bloom.';updateOshiCardSelect();updateUpgradeOshiCardSelect();}
function updateOwnedSummary(){
  const owned=MASTER_DB.cards.filter(c=>getOwnedEntry(c.id).owned),eligible=owned.filter(poolAllowsCard),members=new Set(eligible.map(c=>c.characterId)),raw=validTeamCombinationCount(eligible,5),poolLabel=$('cardpool').value==='all'?'3★–5★':'5★';
  $('ownedcount').textContent=`${owned.length} owned · ${eligible.length} eligible ${poolLabel} cards · ${members.size} distinct holomems`;
  if(['owned','oshi','oshi-prefer'].includes($('searchmode').value))$('searchnote').textContent=`${eligible.length} eligible owned ${poolLabel} cards.`;updateQuickRosterSummary();
}
function ownedCardRow(c,isOshi,locked,query){
  if(query&&!cardSearchText(c).includes(query))return null;const e=getOwnedEntry(c.id);if(locked&&isOshi&&!e.owned){setOwnedEntry(c.id,{owned:true});e.owned=true;}
  const row=document.createElement('div');row.className='owned-item'+(isOshi?' oshi':'');row.dataset.cardId=c.id;
  const main=document.createElement('label');main.className='owned-main';const box=document.createElement('input');box.type='checkbox';box.checked=e.owned;box.disabled=Boolean(locked&&isOshi);const art=document.createElement('span');art.innerHTML=cardArtHtml(c);const artNode=art.firstElementChild;const title=document.createElement('span');title.className='owned-card-copy';title.innerHTML=`<b>${escapeHtml(stars(c.rarity))} ${escapeHtml(c.member)}</b><span class="owned-card-name">${escapeHtml(c.name)}</span><small>${escapeHtml(c.attribute)} · ${escapeHtml(c.groupLabels.join(' / ')||'No group')}</small>`;main.append(box,artNode,title);
  const prog=document.createElement('div');prog.className='owned-progression';prog.style.display=e.owned?'grid':'none';const lev=document.createElement('label');lev.innerHTML=`Lv <input class="owned-level" type="number" min="1" max="${c.maxLevel}" value="${e.level}">`;const bloom=document.createElement('label');const bs=document.createElement('select');bs.className='owned-bloom';for(let b=0;b<=5;b++){const o=document.createElement('option');o.value=b;o.textContent=`Bloom ${b}`;bs.appendChild(o);}bs.value=String(e.bloom);bloom.append('Bloom ',bs);prog.append(lev,bloom);row.append(main,prog);
  box.addEventListener('change',()=>{setOwnedEntry(c.id,{owned:box.checked});prog.style.display=box.checked?'grid':'none';saveOwnedProgress();updateOwnedSummary();populateRequiredOptions();populateExclusionOptions();});
  lev.querySelector('input').addEventListener('change',ev=>{setOwnedEntry(c.id,{level:ev.target.value});ev.target.value=getOwnedEntry(c.id).level;saveOwnedProgress();});
  bs.addEventListener('change',()=>{setOwnedEntry(c.id,{bloom:bs.value});saveOwnedProgress();});return row;
}
function renderOwnedCards(){const list=$('ownedlist');if(!list||!MASTER_DB)return;const mode=$('searchmode').value,isOshiMode=mode==='anchor'||mode==='oshi'||mode==='oshi-prefer',oshiCard=mode==='anchor'?$('anchor').value:null,locked=mode==='anchor'&&$('ownedonly').checked,query=String($('ownedsearch').value||'').trim().toLowerCase();list.innerHTML='';let shown=0;const sorted=[...MASTER_DB.cards].sort((a,b)=>b.rarity-a.rarity||a.member.localeCompare(b.member,'en-US')||a.name.localeCompare(b.name,'en-US'));for(const c of sorted){const row=ownedCardRow(c,c.id===oshiCard||((mode==='oshi'||mode==='oshi-prefer')&&c.characterId===SELECTED_OSHI_CHARACTER_ID),locked,query);if(row){list.appendChild(row);shown++;}}if(!shown){const empty=document.createElement('div');empty.className='owned-empty';empty.textContent='No cards match this filter.';list.appendChild(empty);}saveOwnedProgress();updateOwnedSummary();}
function setOwnedCards(selectAll){for(const c of MASTER_DB.cards)setOwnedEntry(c.id,{owned:selectAll});if($('searchmode').value==='anchor'&&$('ownedonly').checked)setOwnedEntry($('anchor').value,{owned:true});saveOwnedProgress();renderOwnedCards();}
function maxOwnedCards(){for(const c of MASTER_DB.cards){const e=getOwnedEntry(c.id);if(e.owned)setOwnedEntry(c.id,{level:c.maxLevel,bloom:5});}saveOwnedProgress();renderOwnedCards();}
function syncOwnedMode(){const mode=$('searchmode').value,isAnchor=mode==='anchor',isRosterMode=['owned','oshi','oshi-prefer'].includes(mode),poolLabel=$('cardpool').value==='all'?'3★–5★':'5★';$('ownedwrap').style.display='block';if(isRosterMode){$('ownedonly').checked=true;$('ownedonly').disabled=true;$('ownedtoggletext').textContent='Use my saved roster';$('ownedhelp').textContent=`Owned ${poolLabel} cards use your saved progression.`;}else if(isAnchor){$('ownedonly').disabled=false;$('ownedonly').checked=ANCHOR_OWNED_OPTION;$('ownedtoggletext').textContent='Use only cards I own';$('ownedhelp').textContent=`The selected card is included; saved progression is used when owned-only is enabled.`;}else{$('ownedonly').disabled=false;}const active=isRosterMode||(isAnchor&&$('ownedonly').checked);$('ownedpanel').style.display=active?'block':'none';$('ownednone').textContent=isAnchor&&active?'Clear others':'Clear all';if(isAnchor&&active)setOwnedEntry($('anchor').value,{owned:true});renderOwnedCards();}
function personalRosterParams(){const mode=$('searchmode').value,enabled=['owned','oshi','oshi-prefer'].includes(mode)||(mode==='anchor'&&$('ownedonly').checked);if(!enabled)return{ownedOnly:false,ownedKeys:[]};if(mode==='anchor')setOwnedEntry($('anchor').value,{owned:true});saveOwnedProgress();const owned=MASTER_DB.cards.filter(c=>getOwnedEntry(c.id).owned),eligible=owned.filter(poolAllowsCard),members=new Set(eligible.map(c=>c.characterId));if(eligible.length<5)throw new Error('Select at least five owned cards in the chosen team-card pool.');if(members.size<5)throw new Error('Select owned cards belonging to at least five different holomems in the chosen team-card pool.');if($('outfitmode').value==='fixed'&&!getOwnedEntry($('outfitpick').value)?.owned)throw new Error('The selected specific Outfit belongs to a card that is not marked as owned.');return{ownedOnly:true,ownedKeys:owned.map(c=>c.id)};}

function constraintCardOption(card,kind){const required=kind==='required',label=document.createElement('label');label.className='exclude-item';const box=document.createElement('input');box.type='checkbox';box.value=required?card.id:`card:${card.id}`;box.checked=required?REQUIRED_CARD_SELECTIONS.has(card.id):EXCLUDED_SELECTIONS.has(`card:${card.id}`);box.dataset[required?'requiredCard':'exclusion']='1';const art=document.createElement('span');art.innerHTML=cardArtHtml(card,'constraint-art','lazy');const artNode=art.firstElementChild;const text=document.createElement('span');text.innerHTML=`<b>${escapeHtml(stars(card.rarity))} ${escapeHtml(card.member)}</b><small>${escapeHtml(card.name)} · ${escapeHtml(card.attribute)}</small>`;label.append(box,artNode,text);return label;}
function updateExclusionSummary(){const count=EXCLUDED_SELECTIONS.size;if(!count){$('excludedsummary').textContent='No excluded cards';return;}$('excludedsummary').textContent=count===1?'1 excluded card':`${count} excluded cards`;}
function constraintPoolCards(){const pool=currentPoolCards();return $('ownedonly')?.checked?pool.filter(c=>getOwnedEntry(c.id).owned):pool;}
function renderExclusionOptions(){const list=$('excludedoptions'),query=$('excludedsearch').value.trim().toLowerCase();list.innerHTML='';const cs=[...constraintPoolCards()].sort((a,b)=>b.rarity-a.rarity||a.member.localeCompare(b.member,'en-US')||a.name.localeCompare(b.name,'en-US')).filter(c=>cardSearchText(c).includes(query));for(const c of cs)list.appendChild(constraintCardOption(c,'excluded'));if(!cs.length){const e=document.createElement('div');e.className='owned-empty';e.textContent='No matching cards.';list.appendChild(e);}updateExclusionSummary();}
function populateExclusionOptions(){const valid=new Set(constraintPoolCards().map(c=>`card:${c.id}`));for(const x of [...EXCLUDED_SELECTIONS])if(!valid.has(x))EXCLUDED_SELECTIONS.delete(x);renderExclusionOptions();}
function requiredCardOption(card){return constraintCardOption(card,'required');}
function updateRequiredSummary(){const count=REQUIRED_CARD_SELECTIONS.size;if(!count){$('requiredsummary').textContent='No required cards';return;}$('requiredsummary').textContent=count===1?'1 required card':`${count} required cards`;}
function renderRequiredOptions(){const list=$('requiredoptions'),query=$('requiredsearch').value.trim().toLowerCase();list.innerHTML='';const pool=[...constraintPoolCards()].sort((a,b)=>b.rarity-a.rarity||a.member.localeCompare(b.member,'en-US')||a.name.localeCompare(b.name,'en-US')).filter(c=>cardSearchText(c).includes(query));if(pool.length){for(const c of pool)list.appendChild(requiredCardOption(c));}else{const e=document.createElement('div');e.className='exclude-empty';e.textContent='No matching cards in the current pool.';list.appendChild(e);}updateRequiredSummary();}
function populateRequiredOptions(){const valid=new Set(constraintPoolCards().map(c=>c.id));for(const id of [...REQUIRED_CARD_SELECTIONS])if(!valid.has(id))REQUIRED_CARD_SELECTIONS.delete(id);renderRequiredOptions();}
function validateRequiredSelection(nextId){const c=masterCard(nextId);if(!c)return 'That card is no longer available in the current pool.';const mode=$('searchmode').value,anchor=mode==='anchor'?masterCard($('anchor').value):null;if(anchor&&anchor.id!==c.id&&anchor.characterId===c.characterId)return `${c.member} is already required by the build-around card.`;for(const id of REQUIRED_CARD_SELECTIONS){if(id===c.id)continue;const other=masterCard(id);if(other&&other.characterId===c.characterId)return `${c.member} already has another required card selected.`;}const distinct=new Set([...REQUIRED_CARD_SELECTIONS].map(id=>masterCard(id)?.characterId).filter(Boolean));if(anchor)distinct.add(anchor.characterId);distinct.add(c.characterId);if(distinct.size>5)return 'A five-member team cannot contain more than five required cards.';return '';}

const TAB_NAMES=new Set(['optimizer','compare','methodology','legal','changelog']);
function initializeCompactChangelog(){
  const entries=[...document.querySelectorAll('#page-changelog .changelog-entry')];
  entries.forEach((entry,index)=>{
    if(entry.tagName==='DETAILS')return;
    const details=document.createElement('details');details.className=entry.className;
    if(entry.getAttribute('style'))details.setAttribute('style',entry.getAttribute('style'));
    const heading=entry.querySelector(':scope > h3');
    const summary=document.createElement('summary');
    const title=document.createElement('span');title.className='changelog-version';title.textContent=heading?.textContent?.trim()||'Release';summary.appendChild(title);
    const firstStrong=entry.querySelector('li strong');
    if(firstStrong){const hint=document.createElement('small');hint.textContent=firstStrong.textContent.replace(/:\s*$/,'');summary.appendChild(hint);}
    details.appendChild(summary);
    [...entry.children].forEach(child=>{if(child!==heading)details.appendChild(child);});
    if(index===0)details.open=true;
    entry.replaceWith(details);
  });
}
function activateTab(name,{updateHash=true}={}){if(!TAB_NAMES.has(name))name='optimizer';document.querySelectorAll('.tab-page').forEach(page=>{const active=page.id===`page-${name}`;page.classList.toggle('active',active);page.hidden=!active;});document.querySelectorAll('.tab-button').forEach(button=>{const active=button.dataset.tab===name;button.classList.toggle('active',active);button.setAttribute('aria-selected',active?'true':'false');});if(updateHash&&location.hash!==`#${name}`)history.replaceState(null,'',`#${name}`);}
const SEARCHABLE_SELECTS=new Map();
function normalizedSelectSearchText(value){return String(value||'').normalize('NFKC').toLowerCase().replace(/\s+/g,' ').trim();}
function enhanceSearchableSelect(id,{placeholder='Filter…',maxResults=80}={}){
 const select=$(id);if(!select||SEARCHABLE_SELECTS.has(id))return;
 const host=document.createElement('div');host.className='filter-select';
 const current=document.createElement('button');current.type='button';current.id=`${id}-filter-toggle`;current.className='filter-select-current';current.setAttribute('aria-haspopup','listbox');current.setAttribute('aria-expanded','false');
 const currentText=document.createElement('span');currentText.className='filter-select-current-text';const arrow=document.createElement('span');arrow.className='filter-select-arrow';arrow.setAttribute('aria-hidden','true');arrow.textContent='▾';current.append(currentText,arrow);
 const panel=document.createElement('div');panel.className='filter-select-panel';
 const input=document.createElement('input');input.type='search';input.id=`${id}-search`;input.className='filter-select-input';input.placeholder=placeholder;input.autocomplete='off';input.setAttribute('aria-label',placeholder);
 const menu=document.createElement('div');menu.className='filter-select-options';menu.id=`${id}-search-menu`;menu.setAttribute('role','listbox');input.setAttribute('aria-controls',menu.id);
 panel.append(input,menu);select.parentNode.insertBefore(host,select);host.append(current,panel,select);select.classList.add('filter-select-native');select.setAttribute('aria-hidden','true');select.tabIndex=-1;
 const label=document.querySelector(`label[for="${CSS.escape(id)}"]`);if(label)label.htmlFor=current.id;
 const state={host,current,currentText,panel,input,menu,select,active:-1,rows:[],open:false};SEARCHABLE_SELECTS.set(id,state);
 const selectedText=()=>select.selectedOptions?.[0]?.textContent||'Select…';
 function updateCurrent(){currentText.textContent=selectedText();current.title=selectedText();}
 function close({focus=false}={}){state.open=false;host.classList.remove('open');current.setAttribute('aria-expanded','false');state.active=-1;input.value='';if(focus)current.focus();}
 function choose(value){if(![...select.options].some(o=>o.value===value))return;select.value=value;select.dispatchEvent(new Event('change',{bubbles:true}));updateCurrent();close({focus:true});}
 function paint(query=''){const q=normalizedSelectSearchText(query),all=[...select.options];let matches=all;if(q){matches=all.map((o,i)=>{const t=normalizedSelectSearchText(o.textContent),at=t.indexOf(q);if(at<0)return null;const boundary=at===0||/[^a-z0-9]/.test(t[at-1]);const rank=t===q?0:t.startsWith(q)?1:boundary?2:3;return{o,i,rank};}).filter(Boolean).sort((a,b)=>a.rank-b.rank||a.i-b.i).map(x=>x.o);}state.rows=matches.slice(0,maxResults);state.active=-1;menu.innerHTML='';if(!state.rows.length){const e=document.createElement('div');e.className='filter-select-empty';e.textContent='No matches.';menu.appendChild(e);}else for(const o of state.rows){const b=document.createElement('button');b.type='button';b.className='filter-select-option'+(o.value===select.value?' selected':'');b.dataset.value=o.value;b.setAttribute('role','option');b.setAttribute('aria-selected',o.value===select.value?'true':'false');b.textContent=o.textContent;menu.appendChild(b);}if(matches.length>maxResults){const h=document.createElement('div');h.className='filter-select-hint';h.textContent=`Showing ${maxResults} of ${matches.length} matches — type to narrow the list.`;menu.appendChild(h);}}
 function open(){if(state.open)return;state.open=true;host.classList.add('open');current.setAttribute('aria-expanded','true');input.value='';paint('');queueMicrotask(()=>input.focus());}
 function move(delta){if(!state.rows.length)return;state.active=(state.active+delta+state.rows.length)%state.rows.length;menu.querySelectorAll('.filter-select-option').forEach((b,i)=>b.classList.toggle('active',i===state.active));menu.querySelectorAll('.filter-select-option')[state.active]?.scrollIntoView({block:'nearest'});}
 current.addEventListener('click',()=>state.open?close():open());input.addEventListener('input',()=>paint(input.value));input.addEventListener('keydown',e=>{if(e.key==='ArrowDown'){e.preventDefault();move(1);}else if(e.key==='ArrowUp'){e.preventDefault();move(-1);}else if(e.key==='Enter'&&state.rows.length){e.preventDefault();choose(state.rows[Math.max(0,state.active)].value);}else if(e.key==='Escape'){e.preventDefault();close({focus:true});}});menu.addEventListener('mousedown',e=>{const b=e.target.closest('.filter-select-option');if(!b)return;e.preventDefault();choose(b.dataset.value);});select.addEventListener('change',()=>{updateCurrent();if(state.open)paint(input.value);});document.addEventListener('mousedown',e=>{if(!host.contains(e.target))close();});new MutationObserver(()=>queueMicrotask(()=>{updateCurrent();if(state.open)paint(input.value);})).observe(select,{childList:true,subtree:true});updateCurrent();
}
function syncSearchableSelect(id){const state=SEARCHABLE_SELECTS.get(id);if(!state)return;state.open=false;state.active=-1;state.host.classList.remove('open');state.current.setAttribute('aria-expanded','false');state.input.value='';state.currentText.textContent=state.select.selectedOptions?.[0]?.textContent||'Select…';state.current.title=state.currentText.textContent;}
function initializeSearchableSelectors(){const specs={anchor:'Filter cards…',outfitpick:'Filter cards or Outfits…',chartsong:'Filter songs…','compare-chartsong':'Filter songs…','compare-a-outfit':'Filter cards or Outfits…','compare-b-outfit':'Filter cards or Outfits…'};for(const side of ['a','b'])for(let pos=1;pos<=5;pos++)specs[`compare-${side}-${pos}`]='Filter cards…';for(const [id,placeholder] of Object.entries(specs))enhanceSearchableSelect(id,{placeholder});}
function fillSelect(select,cards,previous,formatter){select.innerHTML='';for(const c of cards){const o=document.createElement('option');o.value=c.id;o.textContent=formatter(c);select.appendChild(o);}if(cards.some(c=>c.id===previous))select.value=previous;}
function compareSlotState(side,pos){const id=$(`compare-${side}-${pos}`).value,c=masterCard(id),board=+$(`compare-${side}-${pos}-board`)?.value||0;return{id,level:+$(`compare-${side}-${pos}-level`).value||c?.maxLevel||1,bloom:+$(`compare-${side}-${pos}-bloom`).value||0,board:[0,1,2,3].includes(board)?board:0};}
function defaultCompareProgress(id){const c=masterCard(id),e=getOwnedEntry(id),d=defaultProgress(c);return e?.owned?{level:e.level,bloom:e.bloom}:{level:d.level,bloom:d.bloom};}
function setCompareSlot(side,pos,state,{preserve=false}={}){const sel=$(`compare-${side}-${pos}`);if(state?.id&&[...sel.options].some(o=>o.value===state.id))sel.value=state.id;const c=masterCard(sel.value);if(!c)return;const p=preserve&&state?.id===c.id?state:defaultCompareProgress(c.id),lev=$(`compare-${side}-${pos}-level`),bloom=$(`compare-${side}-${pos}-bloom`),board=$(`compare-${side}-${pos}-board`);lev.min=1;lev.max=c.maxLevel;lev.value=Math.max(1,Math.min(c.maxLevel,Math.round(Number(p.level)||c.maxLevel)));bloom.value=String(Math.max(0,Math.min(5,Math.round(Number(p.bloom)||0))));if(board){const bp=[0,1,2,3].includes(Number(p.board))?Number(p.board):0;board.value=String(bp);}$(`compare-${side}-${pos}-meta`).textContent=`${stars(c.rarity)} · ${c.attribute} · max Lv ${c.maxLevel}`;syncSearchableSelect(`compare-${side}-${pos}`);setComparePreview(side,pos,c);}
function comparisonDefaults(){const out=[],seen=new Set();for(const c of [...MASTER_DB.cards].sort((a,b)=>b.rarity-a.rarity||a.member.localeCompare(b.member,'en-US'))){if(seen.has(c.characterId))continue;seen.add(c.characterId);out.push(c.id);}return out;}
function populateComparisonSelectors(){const defaults=comparisonDefaults(),states={};for(const side of ['a','b'])for(let pos=1;pos<=5;pos++){const sel=$(`compare-${side}-${pos}`);states[`${side}${pos}`]=sel.value?compareSlotState(side,pos):null;}const oldA=$('compare-a-outfit').value,oldB=$('compare-b-outfit').value,cards=[...MASTER_DB.cards].sort((a,b)=>b.rarity-a.rarity||a.member.localeCompare(b.member,'en-US')||a.name.localeCompare(b.name,'en-US'));for(const side of ['a','b'])for(let pos=1;pos<=5;pos++){const sel=$(`compare-${side}-${pos}`),state=states[`${side}${pos}`];fillSelect(sel,cards,state?.id,c=>`${stars(c.rarity)} ${c.member} — ${c.name}`);if(!state?.id)sel.value=defaults[(side==='a'?pos-1:pos+4)%defaults.length]||cards[pos-1]?.id;setCompareSlot(side,pos,state,{preserve:true});}fillSelect($('compare-a-outfit'),cards,oldA,c=>`${stars(c.rarity)} ${c.member} — ${c.name} · ${c.outfit.text}`);fillSelect($('compare-b-outfit'),cards,oldB,c=>`${stars(c.rarity)} ${c.member} — ${c.name} · ${c.outfit.text}`);if(!oldA)$('compare-a-outfit').value=$('compare-a-1').value;if(!oldB)$('compare-b-outfit').value=$('compare-b-1').value;updateComparisonOutfitNotes();}
function updateComparisonOutfitNotes(){for(const side of ['a','b']){const c=masterCard($(`compare-${side}-outfit`).value),host=$(`compare-${side}-outfit-note`);host.innerHTML=c?`${cardArtHtml(c)}<span class="compare-outfit-copy"><b>${escapeHtml(stars(c.rarity))} ${escapeHtml(c.member)}</b><span>${escapeHtml(c.outfit.text)}</span></span>`:'';}}
function comparisonTeamStates(side){return [1,2,3,4,5].map(pos=>compareSlotState(side,pos));}
function buildComparisonPayload(){const cards=[],teamA=[],teamB=[];for(const side of ['a','b']){const target=side==='a'?teamA:teamB;for(let pos=1;pos<=5;pos++){const st=compareSlotState(side,pos),c=masterCard(st.id),key=`${side}:${pos}:${c.id}`;cards.push(materializeCard(c,st.level,st.bloom,key,st.board));target.push(key);}}const outfitAId=$('compare-a-outfit').value,outfitBId=$('compare-b-outfit').value,aOut=masterCard(outfitAId),bOut=masterCard(outfitBId),aKey=`a:outfit:${outfitAId}`,bKey=`b:outfit:${outfitBId}`;cards.push(materializeCard(aOut,aOut.maxLevel,DEFAULT_BLOOM,aKey),materializeCard(bOut,bOut.maxLevel,DEFAULT_BLOOM,bKey));const scoringMode=$('compare-scoringmode').value,chartMeta=scoringMode==='chart'?currentCompareChart():null;if(scoringMode==='chart'&&(!chartMeta||!chartMeta.timelineAvailable))throw new Error('The selected comparison chart does not have a validated live timeline. Choose another difficulty or use Any song.');const chart=scoringMode==='chart'?materializeChart(chartMeta):null,song=scoringMode==='chart'?Math.max(30,Math.ceil(Number(chart.playingSeconds)||Number(chart.beatmapSeconds)||140)):+$('compare-song').value;return{cards,params:{action:'compare',teamA,outfitA:aKey,teamB,outfitB:bKey,scoringMode,chart:chart?structuredClone(chart):null,song,specialMode:scoringMode==='chart'?'exact':'combo',other:+$('compare-other').value,runsPerAverage:+$('compare-runs').value}};}
function setComparisonError(message=''){$('compare-error').style.display=message?'block':'none';$('compare-error').textContent=message;}
function setComparisonTeam(side,cardIds,progress,outfitId){if(!Array.isArray(cardIds)||cardIds.length!==5)return;cardIds.forEach((id,i)=>setCompareSlot(side,i+1,{id,level:progress?.[i]?.level,bloom:progress?.[i]?.bloom,board:progress?.[i]?.board??progress?.[i]?.boardFrequencyNodes??progress?.[i]?.boardActiveFrequencyNodes??Math.round((progress?.[i]?.boardActiveFrequencyPct||0)/4)},{preserve:true}));if(outfitId&&[...$(`compare-${side}-outfit`).options].some(o=>o.value===outfitId))$(`compare-${side}-outfit`).value=outfitId;syncSearchableSelect(`compare-${side}-outfit`);updateComparisonOutfitNotes();}
function loadLatestComparisonTeam(side){const best=lastResults[0];if(!best)return;setComparisonTeam(side,best.cardIds,best.cardProgress,best.outfitCard);activateTab('compare');}
function swapComparisonTeams(){const a=comparisonTeamStates('a'),b=comparisonTeamStates('b'),ao=$('compare-a-outfit').value,bo=$('compare-b-outfit').value;setComparisonTeam('a',b.map(x=>x.id),b,bo);setComparisonTeam('b',a.map(x=>x.id),a,ao);}
function copyComparisonAToB(){const a=comparisonTeamStates('a'),ao=$('compare-a-outfit').value;setComparisonTeam('b',a.map(x=>x.id),a,ao);setComparisonError('');$('compare-results').style.display='none';}
function comparisonRangeText(range){return `${fmt(range.p05,0)}–${fmt(range.p95,0)}`;}
function comparisonTeamHtml(result,label){const external=result.outfitExternal?' · external Outfit card':'';return `<div class="compare-team-visual"><strong>${label}</strong>${resultTeamLineup(result,{compact:true})}<span class="tiny">Outfit: ${escapeHtml(result.outfitOwner)} — ${escapeHtml(result.outfitText)}${external}${result.outfitTriggered?'':' · no effect triggered'}</span></div>`;}
function renderComparison(m){lastComparison=m;const runs=m.runsPerAverage,unit=runs===1?'individual run':`${runs}-run average`,winner=m.winner==='A'?'Team A':'Team B',winnerProb=m.winner==='A'?m.winProbabilityA:m.winProbabilityB,signed=m.expectedDiff>=0?`+${fmt(m.expectedDiff*100,2)}%`:`${fmt(m.expectedDiff*100,2)}%`,result=$('compare-results'),modeLabel=m.scoringMode==='chart'?`${m.chartTitle} · ${m.chartDifficulty} · exact Perfect FC`:'Any song · calibrated average-chart model';result.innerHTML=`<div class="compare-callout"><strong>${winner} has a ${fmt(m.advantage*100,2)}% higher expected index.</strong><p>${escapeHtml(m.interpretation)}</p><p class="tiny"><b>Scoring:</b> ${escapeHtml(modeLabel)}</p></div><div class="compare-metrics"><div class="compare-metric"><b>${fmt(m.teamA.score,0)}</b><span>Team A expected index</span></div><div class="compare-metric"><b>${fmt(m.teamB.score,0)}</b><span>Team B expected index</span></div><div class="compare-metric"><b>${signed}</b><span>Team A relative to Team B</span></div><div class="compare-metric"><b>${fmt(winnerProb*100,1)}%</b><span>${winner} wins the ${unit}</span></div></div><div class="compare-grid" style="margin-bottom:14px">${comparisonTeamHtml(m.teamA,'Team A')}${comparisonTeamHtml(m.teamB,'Team B')}</div><div class="compare-table"><table><thead><tr><th>Metric</th><th>Team A</th><th>Team B</th></tr></thead><tbody><tr><td>${m.scoringMode==='chart'?'Song-specific Expected Index':'Any-song Expected Index'}</td><td><b>${fmt(m.teamA.score,0)}</b></td><td><b>${fmt(m.teamB.score,0)}</b></td></tr><tr><td>Team stat</td><td>${fmt(m.teamA.stat,0)}</td><td>${fmt(m.teamB.stat,0)}</td></tr><tr><td>Raw Active</td><td>${fmt(m.teamA.raw,2)}%</td><td>${fmt(m.teamB.raw,2)}%</td></tr><tr><td>Support uplift</td><td>${fmt(m.teamA.uplift,2)}%</td><td>${fmt(m.teamB.uplift,2)}%</td></tr><tr><td>SAR uplift</td><td>${fmt(m.teamA.sarUplift||0,2)}%</td><td>${fmt(m.teamB.sarUplift||0,2)}%</td></tr><tr><td>Special support uplift</td><td>${fmt(m.teamA.specialSupportUplift??m.teamA.specialBonus,2)}%</td><td>${fmt(m.teamB.specialSupportUplift??m.teamB.specialBonus,2)}%</td></tr><tr><td>Total bonus</td><td>${fmt(m.teamA.totalBonus,2)}%</td><td>${fmt(m.teamB.totalBonus,2)}%</td></tr><tr><td>Active coverage</td><td>${fmt(m.teamA.coverage*100,1)}%</td><td>${fmt(m.teamB.coverage*100,1)}%</td></tr><tr><td>Estimated chance to win ${unit}</td><td>${fmt(m.winProbabilityA*100,1)}%</td><td>${fmt(m.winProbabilityB*100,1)}%</td></tr><tr><td>Simulated 5th–95th percentile for ${unit}</td><td>${comparisonRangeText(m.rangeA)}</td><td>${comparisonRangeText(m.rangeB)}</td></tr><tr><td>Single-run modeled standard deviation</td><td>${fmt(m.individualA.sd/m.teamA.score*100,2)}%</td><td>${fmt(m.individualB.sd/m.teamB.score*100,2)}%</td></tr></tbody></table></div><div class="compare-method-note"><b>Simulation scope:</b> ${m.individualDraws.toLocaleString(NUMBER_LOCALE)} individual modeled scores were generated per team, then ${m.comparisonDraws.toLocaleString(NUMBER_LOCALE)} independent ${unit} comparisons were sampled. ${m.scoringMode==='chart'?'Active checks are randomized on the real chart timeline; combo-dependent magnitude, exact note-weight coverage, Special windows, and SAR-adjusted activation probabilities follow the selected Perfect-FC chart.':'Active checks use the Any song duration model; Special Score Support and SAR use the corrected 702-chart empirical average calibration.'} This probability is not a p-value and does not include player accuracy, Memory, Member Power-Up, or Holomem Board effects other than the per-member Frequency Up node values selected above.</div>`;result.style.display='block';}
function runComparison(){setComparisonError('');$('compare-results').style.display='none';let payload;try{payload=buildComparisonPayload();}catch(e){setComparisonError(e.message||String(e));return;}const acquired=acquireComparisonWorker(payload.cards);compareWorker=acquired.instance;$('compare-run').disabled=true;$('compare-cancel').style.display='block';$('compare-progress').style.display='block';$('compare-barfill').style.width='2%';$('compare-status').textContent=acquired.reused?'Reusing initialized comparison engine…':'Starting comparison engine…';compareWorker.onmessage=e=>{const m=e.data;if(m.type==='compareProgress'){$('compare-barfill').style.width=`${Math.round((m.progress||0)*100)}%`;$('compare-status').textContent=m.phase;}else if(m.type==='compareDone'){$('compare-barfill').style.width='100%';$('compare-status').textContent='Comparison complete · engine cached for this roster.';renderComparison(m);$('compare-run').disabled=false;$('compare-cancel').style.display='none';}else if(m.type==='error'){setComparisonError(m.message||'Comparison failed.');$('compare-run').disabled=false;$('compare-cancel').style.display='none';$('compare-progress').style.display='none';}};compareWorker.postMessage(payload.params);}

function populateDatabaseSelectors(){const oldAnchor=$('anchor').value,oldOutfit=$('outfitpick').value,pool=[...currentPoolCards()].sort((a,b)=>b.rarity-a.rarity||a.member.localeCompare(b.member,'en-US')||a.name.localeCompare(b.name,'en-US')),all=[...MASTER_DB.cards].sort((a,b)=>b.rarity-a.rarity||a.member.localeCompare(b.member,'en-US')||a.name.localeCompare(b.name,'en-US'));fillSelect($('anchor'),pool,oldAnchor,c=>`${stars(c.rarity)} ${c.member} — ${c.name}`);fillSelect($('outfitpick'),all,oldOutfit,c=>`${stars(c.rarity)} ${c.member} — ${c.name} · ${c.outfit.text}`);populateExclusionOptions();populateRequiredOptions();populateComparisonSelectors();updateSelectionPreviews();updateOshiCardSelect();}
function clearRunResults(){discardOptimizerWorker();discardComparisonWorker();lastResults=[];lastComparison=null;$('run').disabled=false;$('cancel').style.display='none';$('csv').style.display='none';$('progressbox').style.display='none';$('tablewrap').style.display='none';$('kpis').style.display='none';$('empty').style.display='flex';$('compare-results').style.display='none';$('compare-progress').style.display='none';$('compare-error').style.display='none';$('compare-load-a').disabled=true;$('compare-load-b').disabled=true;}
function params(){const mode=$('searchmode').value,roster=personalRosterParams(),scoringMode=$('scoringmode').value,chartMeta=scoringMode==='chart'?currentChart():null;if(scoringMode==='chart'&&(!chartMeta||!chartMeta.timelineAvailable))throw new Error('The selected chart does not have a validated live timeline in this release.');const chart=scoringMode==='chart'?materializeChart(chartMeta):null;return{searchMode:mode,anchor:mode==='anchor'?$('anchor').value:null,oshiCharacterId:SELECTED_OSHI_CHARACTER_ID||null,cardPool:$('cardpool').value,searchQuality:$('searchquality').value,outfitMode:$('outfitmode').value,outfitKey:$('outfitpick').value,boardMode:$('boardmode')?.value==='optimize'?'optimize':'off',boardFrequencyNodes:Math.max(0,Math.min(12,Math.round(+$('board-frequency-nodes')?.value||0))),scoringMode,chart:chart?structuredClone(chart):null,song:scoringMode==='chart'?Math.max(30,Math.ceil(Number(chart.playingSeconds)||Number(chart.beatmapSeconds)||140)):+$('song').value,specialMode:scoringMode==='chart'?'exact':'combo',other:+$('other').value,topN:+$('topn').value,fullOrder:$('fullorder').checked,excluded:[...EXCLUDED_SELECTIONS],requiredCards:[...REQUIRED_CARD_SELECTIONS],requiredMembers:[],...roster};}
function syncOutfitMode(){let mode=$('outfitmode').value;const oshiActive=$('goal-oshi')?.classList.contains('active');if(mode==='oshi'&&!oshiActive){mode='best';$('outfitmode').value='best';}const oshiChoice=$('outfit-choice-oshi');if(oshiChoice)oshiChoice.hidden=!oshiActive;document.querySelectorAll('input[name="outfit-choice"]').forEach(r=>{r.checked=r.value===mode;});const fixed=mode==='fixed';$('outfitpickwrap').style.display=fixed?'block':'none';$('outfitnote').textContent=mode==='oshi'?"Uses the selected Oshi card's Outfit.":mode==='fixed'?'Uses the selected specific Outfit.':mode==='any'?'Chooses the best Outfit from any owned card.':'Chooses the best Outfit among the five team cards.';if(mode==='oshi'&&$('oshi-card-select')?.value){SELECTED_OSHI_CHARACTER_ID=masterCard($('oshi-card-select').value)?.characterId||SELECTED_OSHI_CHARACTER_ID;}syncQuickDefaults();}
function syncSearchMode(){const mode=$('searchmode').value,isAnchor=mode==='anchor',isOwned=mode==='owned',isOshi=mode==='oshi'||mode==='oshi-prefer',isGlobal=mode==='global',poolLabel=$('cardpool').value==='all'?'3★–5★':'5★';$('anchorwrap').style.display=isAnchor?'block':'none';$('fullorder').disabled=false;$('fullorder').checked=true;if(isGlobal){$('searchnote').textContent=`Full ${poolLabel} pool at max Level / Bloom 0.`;$('run').textContent='Find best teams';}else if(isOshi){$('searchnote').textContent='Builds the strongest owned team around your selected oshi.';$('run').textContent='Find best oshi team';}else if(isOwned){$('searchnote').textContent='Finds the strongest team from your saved roster.';$('run').textContent='Find my best team';}else{$('searchnote').textContent='Builds around the selected specific card.';$('run').textContent='Find best team';}syncOwnedMode();syncQuickDefaults();}
function reset(hide=true){$('run').disabled=false;$('cancel').style.display='none';if(hide)$('progressbox').style.display='none';}
function preloadOneImage(url,timeout=700){return new Promise(resolve=>{if(!url){resolve();return;}const im=new Image(),done=()=>resolve();im.onload=done;im.onerror=done;im.src=url;setTimeout(done,timeout);});}
async function preloadResultArtwork(rows){const urls=new Set();for(const r of (rows||[]).slice(0,3)){for(const id of r.cardIds||[]){const c=masterCard(id);if(c)urls.add(cardPortraitUrl(c));}const oc=masterCard(r.outfitCard);if(oc)urls.add(cardPortraitUrl(oc));}await Promise.race([Promise.allSettled([...urls].map(u=>preloadOneImage(u))),new Promise(r=>setTimeout(r,850))]);}
function renderUpgradeRecommendations(payload){const list=$('resultslist');list.innerHTML='';const baseline=payload.baselineScore||payload.baseline?.score||0,recs=payload.recommendations||[],anyGain=recs.some(x=>(Number(x.gain)||0)>1e-8);if(!recs.length){list.innerHTML='<div class="results-empty"><b>No eligible unowned cards found.</b><span>Try All cards or adjust your exclusions.</span></div>';return;}recs.forEach((rec,i)=>{const c=masterCard(rec.cardId),r=rec.result,gain=Math.max(0,Number(rec.gain)||0),card=document.createElement('article');card.className='result-card upgrade-card'+(i===0?' best':'');const badge=gain>1e-8?`+${fmt(gain*100,2)}%`:'No improvement';const statLabel=highestBaseStatLabel(c),p=c?defaultProgress(c):null;card.innerHTML=`<div class="result-head"><div class="result-rank">#${i+1}</div><div class="result-score"><b>${escapeHtml(c?.member||'Unknown card')}</b><span>${escapeHtml(c?.name||'')}</span></div><span class="gap-badge ${i===0?'best':'near'}">${escapeHtml(i===0?(anyGain?'BEST VALUE':'NO UPGRADE'):badge)}</span></div><div class="upgrade-highlight">${cardArtHtml(c,'','eager')}<div class="upgrade-copy"><b>${escapeHtml(c?.member||'Unknown')}</b><span>${escapeHtml(c?.name||'')} · ${escapeHtml(statLabel)} · Lv${p?.level||c?.maxLevel||''} · Bloom 0</span><div class="upgrade-baseline">Current best ${fmt(baseline,0)} → with this card ${fmt(Math.max(baseline,r?.score||0),0)}</div></div><div class="upgrade-gain"><b class="${gain<=1e-8?'upgrade-no-gain':''}">${escapeHtml(badge)}</b><span>best-team impact</span></div></div>${r?`<div class="team-lineup">${r.cardIds.map((_,j)=>resultCardTile(r,j,{loading:i<2?'eager':'lazy'})).join('')}</div>${r.outfitOwner?`<div class="outfit-summary">${outfitSummaryHtml(r)}</div>`:''}`:''}`;list.appendChild(card);});$('tablewrap').style.display='block';}
async function finishUpgrade(m){const sec=(performance.now()-start)/1000;lastResults=(m.recommendations||[]).map(x=>x.result).filter(Boolean);$('compare-load-a').disabled=!lastResults.length;$('compare-load-b').disabled=!lastResults.length;$('barfill').style.width='100%';$('status').textContent='Loading card artwork…';const artRows=lastResults.slice(0,3);await preloadResultArtwork(artRows);const oshi=masterCard(m.upgradeOshiCardId);$('results-heading').textContent=oshi?`Best next cards for ${oshi.member}`:'Best next cards';const anyGain=(m.recommendations||[]).some(x=>(Number(x.gain)||0)>1e-8);if(oshi)$('results-context').textContent=anyGain?`Current best with ${oshi.member} — ${oshi.name}: ${fmt(m.baselineScore||0,0)} · new cards assumed max Level / Bloom 0.`:`No tested unowned card improves your current best team with ${oshi.member} — ${oshi.name}.`;else $('results-context').textContent=anyGain?`Current best ${fmt(m.baselineScore||0,0)} · new cards assumed max Level / Bloom 0.`:`Your current best team is already stronger than every tested unowned card in this pool.`;$('status').textContent=`Done in ${fmt(sec,1)} s`;renderUpgradeRecommendations(m);$('csv').style.display='none';reset(false);}
async function finish(m){$('results-heading').textContent='Your best teams';lastResults=m.results;$('compare-load-a').disabled=!lastResults.length;$('compare-load-b').disabled=!lastResults.length;const sec=(performance.now()-start)/1000,st=m.searchStats||{};$('barfill').style.width='100%';$('status').textContent='Loading team artwork…';$('kbest').textContent=fmt(m.results[0]?.score||0,0);$('ktested').textContent=(st.partialEvaluated??m.tested??0).toLocaleString(NUMBER_LOCALE);$('kvalid').textContent=(st.completeScreened??m.valid??0).toLocaleString(NUMBER_LOCALE);$('ktime').textContent=fmt(sec,1)+' s';await preloadResultArtwork(m.results);const ctx=$('results-context');if(ctx){if(m.oshiPreference)ctx.textContent=m.oshiPreference.usedOshi?`Your oshi team is within 2% of the absolute best (${fmt(m.oshiPreference.gap*100,2)}% gap).`:`Absolute best shown · your oshi team is ${fmt(m.oshiPreference.gap*100,2)}% behind.`;else if(m.oshiCharacterId){const c=MASTER_DB.cards.find(x=>x.characterId===m.oshiCharacterId);ctx.textContent=`Best team built around ${c?.member||'your oshi'}.`;}else if($('goal-oshi')?.classList.contains('active')){const c=masterCard($('oshi-card-select')?.value);ctx.textContent=`Best team built around ${c?.member||'your oshi'}.`;}else ctx.textContent='Best teams from your roster.';}$('status').textContent=`Done in ${fmt(sec,1)} s`;render(m.results);$('csv').style.display='block';reset(false);}
function gapClass(gap){if(gap<1e-10)return{label:'BEST',cls:'best'};if(gap<.02)return{label:`-${fmt(gap*100,2)}% · near-tie`,cls:'near'};if(gap<.05)return{label:`-${fmt(gap*100,2)}% · small difference`,cls:'small'};if(gap<.10)return{label:`-${fmt(gap*100,2)}% · meaningful gap`,cls:'meaningful'};return{label:`-${fmt(gap*100,2)}% · large gap`,cls:'large'};}
function compactOutfitText(text){let s=String(text||'').replace(/\.$/,'');s=s.replace(/^With\s+(\d+)\s+or more\s+(.+?)\s+Members?,\s*Grants\s+/i,'$1+ $2 → ');s=s.replace(/^Grants\s+/i,'');s=s.replace(/\s+UP\s+/gi,' +');s=s.replace(/\s+to all$/i,'');s=s.replace(/\bPerformance\b/i,'Performance').replace(/\bTechnique\b/i,'Technique').replace(/\bSense\b/i,'Sense').replace(/\bAll Stats\b/i,'All Stats').replace(/\bScore Support\b/i,'Score Support');return s;}
function compactPassiveDetail(text){let s=String(text||'').trim(),source='',condition='';const sm=s.match(/^([^:]+):\s*/);if(sm){source=sm[1].trim();s=s.slice(sm[0].length);}const m=s.match(/^With\s+(\d+)\s+or more\s+(.+?)\s+Members?,\s*/i);if(m){condition=`${m[1]}+ ${m[2]}`;s=s.slice(m[0].length);}const arrow=s.split(/\s*→\s*/);let effect=arrow[0].replace(/^Grants\s+/i,'').replace(/\s+UP\s+/i,' +').replace(/\s+to\s+\d+\s+.+?\s+Members?\.?$/i,'').replace(/\s+to self\.?$/i,'').replace(/\.$/,'').trim(),targets=(arrow[1]||'').trim();return `${source?source+' · ':''}${condition?condition+' · ':''}${effect}${targets?' → '+targets:''}`;}
function render(rows){const list=$('resultslist');list.innerHTML='';rows.forEach((r,n)=>{const card=document.createElement('article');card.className='result-card';const gap=gapClass(r.gap),team=resultTeamLineup(r,{loading:n<2?'eager':'lazy'}),altSame=r.outfitCard===r.bestAvailableOutfitCard&&r.outfitPenalty<1e-10,bestOrderChanged=r.bestAvailableOrder&&r.bestAvailableOrder.join('|')!==r.cards.join('|'),specialLines=(r.specialDetails||[]).map(s=>r.scoringMode==='chart'?`${s.position}. ${escapeHtml(s.member)} @ ${fmt(s.triggerTime,2)}s: +${fmt(s.magnitude,0)}% Score Support for ${fmt(s.duration,0)}s · ${fmt((s.chartWindowShare||0)*100,2)}% chart-weight window · +${fmt(s.bonus,2)}% baseline Active uplift${s.sarPct>0?` · SAR ×${fmt(1+s.sarPct,2)}`:''}`:`${s.position}. ${escapeHtml(s.member)}: +${fmt(s.magnitude,0)}% Score Support for ${fmt(s.duration,0)}s · slot ×${fmt(s.weight,2)} · +${fmt(s.bonus,2)}% baseline Active uplift${s.sarPct>0?` · SAR ×${fmt(1+s.sarPct,2)}`:''}`).join('<br>'),sarLines=(r.sarDetails||[]).map(s=>r.scoringMode==='chart'?`${s.position}. ${escapeHtml(s.member)} @ ${fmt(s.triggerTime,2)}s · SAR ×${fmt(s.multiplier,2)} for ${fmt(s.duration,0)}s · ${s.affectedChecks||0} aligned Active checks`:`${s.position}. ${escapeHtml(s.member)} · SAR ×${fmt(s.multiplier,2)} for ${fmt(s.duration,0)}s · slot ×${fmt(s.weight,2)} → ${fmt(s.passiveUplift,2)}% Active uplift`).join('<br>'),altHtml=alternativeOutfitHtml(r),members=(r.members||r.cards||[]),specials=r.specialDetails||[],chartSkills=r.scoringMode==='chart',activeRows=members.map((member,i)=>{const sp=specials[i]||{},checks=r.activeCheckCounts?.[i],sarChecks=r.sarCheckCounts?.[i];return `<tr><td>${i+1}</td><td>${escapeHtml(member)}</td><td class="numeric">${r.activeProbabilities?.[i]!==undefined?fmt(r.activeProbabilities[i]*100,1)+'%':'—'}</td><td class="numeric">${r.activeMagnitudes?.[i]!==undefined?fmt(r.activeMagnitudes[i],0)+'%':'—'}</td>${chartSkills?`<td class="numeric">${checks??'—'}</td><td class="numeric">${sarChecks??'—'}</td>`:''}<td class="numeric">${sp.magnitude!==undefined?fmt(sp.magnitude,0)+'%':'—'}</td></tr>`;}).join(''),skillHead=`<tr><th>Pos.</th><th>Member</th><th>Proc</th><th>Active</th>${chartSkills?'<th>Checks</th><th>SAR</th>':''}<th>Special support</th></tr>`,passiveItems=(r.passiveDetails||[]).map(x=>`<li title="${escapeHtml(x)}">${escapeHtml(compactPassiveDetail(x))}</li>`).join('')||'<li class="empty">No triggered passive effects.</li>';
card.innerHTML=`<div class="result-head"><div class="result-rank">#${n+1}</div><div class="result-score"><b>${fmt(r.score,0)}</b><span>${r.scoringMode==='chart'?'Song-specific Expected Index · Perfect FC':'Any-song Expected Index'}</span></div><div class="gap-badge ${gap.cls}" title="Difference from rank #1">${gap.label}</div></div>${team}<div class="result-summary"><div class="outfit-summary">${outfitSummaryHtml(r)}</div><div class="result-mini-metrics"><div class="mini-metric"><span>Team stat</span><b>${fmt(r.stat,0)}</b></div><div class="mini-metric"><span>Total bonus</span><b>${fmt(r.totalBonus,2)}%</b></div></div></div><div class="contribution-strip" aria-label="Score contributions"><div class="contribution-item" title="Expected Active Skill score contribution before support multipliers"><span>Active</span><b>${fmt(r.raw,2)}%</b></div><div class="contribution-item" title="Additional Active contribution from Passive and Outfit support"><span>Support</span><b>+${fmt(r.uplift,2)}%</b></div><div class="contribution-item" title="Additional Active contribution from Skill Activation Rate effects"><span>SAR</span><b>+${fmt(r.sarUplift||0,2)}%</b></div><div class="contribution-item" title="Additional Active contribution from Special-window Score Support"><span>Special support</span><b>+${fmt(r.specialSupportUplift??r.specialBonus,2)}%</b></div></div><details class="result-details"><summary>Team details</summary><div class="result-detail-grid"><div class="detail-panel"><h4>Passive effects</h4><ul class="compact-list">${passiveItems}</ul>${altSame?'':`<div class="detail-block alternative-outfit good"><b>Alternative Outfit</b><div class="detail-lines">${altHtml}${bestOrderChanged?'<br>The unrestricted best Outfit uses a different optimal order.':''}</div></div>`}</div><div class="detail-panel"><h4>Skill summary by position</h4><div class="mechanics-table-wrap"><table class="mechanics-table"><thead>${skillHead}</thead><tbody>${activeRows}</tbody></table></div><details class="mechanics-details"><summary>Exact mechanics</summary><div class="mechanics-meta"><span>Adjusted Active ${fmt(r.supported,2)}%</span><span>Active coverage ${fmt(r.coverage*100,1)}%</span><span>Passive support ${r.support.map(x=>fmt(x*100,0)+'%').join(' / ')}</span>${r.outfitPenalty>1e-10?`<span>Outfit penalty ${fmt(r.outfitPenalty*100,2)}%</span>`:''}</div><div class="detail-block"><b>SAR windows</b><div class="detail-lines">${sarLines||'No modeled SAR windows.'}</div></div><div class="detail-block"><b>${r.scoringMode==='chart'?'Song-timed Special support':'Any-song Special-support exposure'}</b><div class="detail-lines">${specialLines||'No modeled Special-support contribution.'}</div></div></details></div></div></details>`;list.appendChild(card);});$('tablewrap').style.display='block';}
function escapeHtml(s){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));}

function initialize(){
  MASTER_DB=structuredClone(BUNDLED_MASTER);MASTER_CARD_BY_ID=new Map(MASTER_DB.cards.map(c=>[c.id,c]));try{const bundled=bundledChartSnapshot();applyChartSnapshot(bundled.snapshot,bundled.source,{allowPacked:true});}catch(err){CHART_PACK=null;applyChartSnapshot(BUNDLED_CHARTS,'Bundled metadata · exact chart companion invalid');showDbMessage(`Exact chart companion rejected: ${err.message||err}`,true);}loadCachedMaster();loadArtworkPreference();if(!OWNERSHIP_LOADED)loadOwnedProgress();else{reconcileOwnedProgress();saveOwnedProgress();}populateDatabaseSelectors();initializeSearchableSelectors();renderOwnedCards();updateDbStatus();syncOutfitMode();syncSearchMode();initializeQuickUX();initializeCompactChangelog();activateTab(location.hash.slice(1)||'optimizer',{updateHash:false});showDbMessage(`Ready with ${DATA_SOURCE.toLowerCase()}. Online updates are checked in the background; failure never blocks the bundled snapshot.`,false);setTimeout(()=>checkDatabaseUpdate({silent:true}),250);
}

document.querySelectorAll('.tab-button').forEach(button=>button.addEventListener('click',()=>activateTab(button.dataset.tab)));
window.addEventListener('hashchange',()=>activateTab(location.hash.slice(1),{updateHash:false}));
$('compare-chartsong').onchange=()=>{populateCompareChartSelectors();syncCompareScoringMode();};$('compare-chartdifficulty').onchange=updateCompareChartStatus;
$('compare-run').onclick=runComparison;$('compare-swap').onclick=swapComparisonTeams;$('compare-copy-a-to-b').onclick=copyComparisonAToB;$('compare-load-a').onclick=()=>loadLatestComparisonTeam('a');$('compare-load-b').onclick=()=>loadLatestComparisonTeam('b');$('compare-cancel').onclick=()=>{discardComparisonWorker();$('compare-run').disabled=false;$('compare-cancel').style.display='none';$('compare-progress').style.display='none';setComparisonError('Comparison cancelled.');};
for(const side of ['a','b']){for(let pos=1;pos<=5;pos++){$(`compare-${side}-${pos}`).addEventListener('change',()=>setCompareSlot(side,pos,null));$(`compare-${side}-${pos}-level`).addEventListener('change',e=>{const c=masterCard($(`compare-${side}-${pos}`).value);e.target.value=Math.max(1,Math.min(c.maxLevel,Math.round(+e.target.value||c.maxLevel)));});}$(`compare-${side}-outfit`).addEventListener('change',updateComparisonOutfitNotes);}
$('excludedsearch').oninput=renderExclusionOptions;$('excludedoptions').onchange=e=>{const box=e.target.closest('input[data-exclusion]');if(!box)return;const id=String(box.value).replace(/^card:/,'');if(box.checked){if($('searchmode').value==='anchor'&&$('anchor').value===id){box.checked=false;alert('Your selected Oshi card cannot also be excluded.');return;}EXCLUDED_SELECTIONS.add(box.value);REQUIRED_CARD_SELECTIONS.delete(id);}else EXCLUDED_SELECTIONS.delete(box.value);renderRequiredOptions();updateExclusionSummary();};$('excludedclear').onclick=()=>{EXCLUDED_SELECTIONS.clear();renderExclusionOptions();};$('requiredsearch').oninput=renderRequiredOptions;$('requiredoptions').onchange=e=>{const box=e.target.closest('input[data-required-card]');if(!box)return;if(box.checked){const err=validateRequiredSelection(box.value);if(err){box.checked=false;alert(err);return;}REQUIRED_CARD_SELECTIONS.add(box.value);EXCLUDED_SELECTIONS.delete(`card:${box.value}`);}else REQUIRED_CARD_SELECTIONS.delete(box.value);renderExclusionOptions();updateRequiredSummary();};$('requiredclear').onclick=()=>{REQUIRED_CARD_SELECTIONS.clear();renderRequiredOptions();};
$('roster-editor').addEventListener('toggle',()=>{if($('roster-editor').open){populateRequiredOptions();populateExclusionOptions();}});$('outfitmode').onchange=syncOutfitMode;$('outfitpick').onchange=updateSelectionPreviews;$('anchor').onchange=()=>{updateSelectionPreviews();syncOwnedMode();renderRequiredOptions();};$('artworktoggle').onchange=e=>setArtworkEnabled(e.target.checked);$('searchmode').onchange=syncSearchMode;$('cardpool').onchange=()=>setCardPool($('cardpool').value);$('ownedonly').onchange=()=>{if($('searchmode').value==='anchor')ANCHOR_OWNED_OPTION=$('ownedonly').checked;syncOwnedMode();};$('ownedsearch').oninput=renderOwnedCards;$('ownedall').onclick=()=>setOwnedCards(true);$('ownednone').onclick=()=>setOwnedCards(false);$('ownedmax').onclick=maxOwnedCards;
$('expand-results').onclick=()=>document.querySelectorAll('.result-details').forEach(d=>d.open=true);$('collapse-results').onclick=()=>document.querySelectorAll('.result-details').forEach(d=>d.open=false);
document.querySelectorAll('#scoring-mode-toggle button[data-mode]').forEach(b=>b.onclick=()=>setOptimizerScoringMode(b.dataset.mode));document.querySelectorAll('#compare-scoring-mode-toggle button[data-mode]').forEach(b=>b.onclick=()=>setComparisonScoringMode(b.dataset.mode));
$('chartimport').onchange=async e=>{const f=e.target.files?.[0];if(!f)return;try{await importChartSnapshot(f);showDbMessage(`Loaded ${chartTimelineCount()} validated chart timelines for this session.`,false);}catch(err){showDbMessage(`Chart import rejected: ${err.message||err}`,true);}finally{e.target.value='';}};$('chartexport').onclick=()=>{try{downloadText('Holodori_Chart_Timelines.json',JSON.stringify(materializeChartSnapshot()),'application/json;charset=utf-8');}catch(err){showDbMessage(`Chart export failed: ${err.message||err}`,true);}};$('chartreset').onclick=()=>{try{const bundled=bundledChartSnapshot();applyChartSnapshot(bundled.snapshot,bundled.source,{allowPacked:true});showDbMessage(`Using ${chartTimelineCount()} bundled exact r51 chart timelines.`,false);}catch(err){CHART_PACK=null;applyChartSnapshot(BUNDLED_CHARTS,'Bundled metadata · exact chart companion unavailable');showDbMessage(`Could not load bundled exact charts: ${err.message||err}`,true);}};$('chartsong').onchange=()=>{populateChartSelectors();syncScoringMode();};$('chartdifficulty').onchange=()=>{updateChartStatusNoSync();};
$('dbupdate').onclick=()=>checkDatabaseUpdate({silent:false,force:false});$('dbexport').onclick=()=>downloadText(`HolodoriDB_Normalized_${String(MASTER_DB.sourceVersion).slice(0,10)}.json`,JSON.stringify(MASTER_DB,null,2),'application/json;charset=utf-8');$('dbreset').onclick=useBundledFallback;
$('run').onclick=()=>{let runParams;try{runParams=params();}catch(err){alert(err.message||String(err));return;}const isUpgrade=$('goal-upgrade')?.classList.contains('active');if(isUpgrade){runParams.action='upgrade';runParams.searchMode='owned';runParams.anchor=null;runParams.oshiCharacterId=null;runParams.upgradeOshiCardId=$('upgrade-scope')?.value==='oshi'?($('upgrade-oshi-card-select')?.value||null):null;}const forcedOutfitId=runParams.outfitMode==='fixed'?runParams.outfitKey:null,cards=optimizerEffectiveCards(runParams.ownedOnly,forcedOutfitId,{unownedAtDefault:isUpgrade}),acquired=acquireOptimizerWorker(cards);worker=acquired.instance;start=performance.now();$('run').disabled=true;$('cancel').style.display='block';$('csv').style.display='none';$('progressbox').style.display='block';$('empty').style.display='none';$('tablewrap').style.display='none';$('kpis').style.display='none';$('barfill').style.width='0%';$('status').textContent=acquired.reused?'Reusing initialized search engine…':'Starting search engine…';worker.onmessage=e=>{const m=e.data;if(m.type==='progress'||m.type==='upgradeProgress'){const pct=m.total?Math.min(100,m.done/m.total*100):0;$('barfill').style.width=pct+'%';$('status').textContent=m.type==='upgradeProgress'?`${m.phase}: ${m.done.toLocaleString(NUMBER_LOCALE)} / ${Math.round(m.total).toLocaleString(NUMBER_LOCALE)}`:`${m.phase}: ${m.done.toLocaleString(NUMBER_LOCALE)} / ${Math.round(m.total).toLocaleString(NUMBER_LOCALE)}`;}else if(m.type==='upgradeDone'){finishUpgrade(m);$('status').textContent+=' Engine cached for this roster.';}else if(m.type==='done'){finish(m);$('status').textContent+=' Engine cached for this roster.';}else if(m.type==='error'){alert(m.message);reset();}};worker.postMessage(runParams);};
$('cancel').onclick=()=>{discardOptimizerWorker();$('status').textContent='Cancelled.';reset(false);};
$('csv').onclick=()=>{if(!lastResults.length)return;const head=['Rank','Position 1','Position 2','Position 3','Position 4','Position 5','Outfit used owner','Outfit used','Outfit used external','Best outfit owner','Best outfit','Best outfit external','Outfit penalty','Team stat','Raw Active','Support uplift','Adjusted Active','Coverage','SAR uplift','Special support uplift','Total bonus','Stat x Score','Gap'];const lines=[head];lastResults.forEach((r,i)=>lines.push([i+1,...r.cards.map((x,j)=>`${x} Lv${r.cardProgress?.[j]?.level||''} B${r.cardProgress?.[j]?.bloom??''}`),r.outfitOwner,r.outfitText,r.outfitExternal,r.bestAvailableOutfitOwner,r.bestAvailableOutfitText,r.bestAvailableOutfitExternal,r.outfitPenalty,r.stat,r.raw,r.uplift,r.supported,r.coverage,r.sarUplift,r.specialSupportUplift??r.specialBonus,r.totalBonus,r.score,r.gap]));const csv=lines.map(row=>row.map(v=>'"'+String(v).replaceAll('"','""')+'"').join(',')).join('\n');downloadText('Holodori_Optimizer_Results.csv',csv,'text/csv;charset=utf-8');};
initialize();

