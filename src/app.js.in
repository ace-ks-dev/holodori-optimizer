let MASTER_DB=null,MASTER_CARD_BY_ID=new Map(),DATA_SOURCE='Bundled fallback',OWNED_PROGRESS=new Map(),OWNERSHIP_LOADED=false,ANCHOR_OWNED_OPTION=true,SELECTED_OSHI_CHARACTER_ID='',updateController=null,CHART_DB=null,CHART_SOURCE='Bundled metadata';
let CHART_PACK=null,CHART_PACK_BYTES=null;const CHART_MATERIALIZED=new Map();
function decodeBase64Bytes(text){const raw=atob(text),out=new Uint8Array(raw.length);for(let i=0;i<raw.length;i++)out[i]=raw.charCodeAt(i);return out;}
function validateBundledChartPack(pack){
  if(!pack||Number(pack.schemaVersion)!==1||Number(pack.packVersion)!==1||!pack.index||typeof pack.data!=='string')throw new Error('Exact chart companion is missing or has an unsupported schema.');
  if(String(pack.sourceVersion)!==String(BUNDLED_CHARTS.sourceVersion))throw new Error('Exact chart companion does not match this optimizer master-data revision.');
  if(Number(pack.timelineCount)!==702||Number(pack.noteCount)!==405194||Number(pack.assetRevision)!==51)throw new Error('Exact chart companion failed release-count validation.');
  return pack;
}
function bundledChartSnapshot(){
  CHART_PACK_BYTES=null;CHART_MATERIALIZED.clear();const snapshot=structuredClone(BUNDLED_CHARTS),pack=globalThis.HOLODORI_CHART_PACK_R51;
  if(!pack){CHART_PACK=null;snapshot.timelineSource='Exact r51 companion not loaded';snapshot.timelineCount=0;return {snapshot,source:'Bundled metadata · exact chart companion missing'};}
  validateBundledChartPack(pack);CHART_PACK=pack;const byKey=new Map(snapshot.charts.map(c=>[c.key,c]));let count=0,notes=0;
  for(const [key,row] of Object.entries(pack.index)){const c=byKey.get(key);if(!c)throw new Error(`Chart companion contains unknown chart: ${key}`);const [offset,n,lastMs]=row.map(Number);if(!Number.isInteger(offset)||offset<0||!Number.isInteger(n)||n<=0||Number(c.fullComboNoteCount)!==n)throw new Error(`Chart companion metadata mismatch: ${key}`);c.timelineAvailable=true;c.timelinePacked=true;c.beatmapSeconds=lastMs/1000;count++;notes+=n;}
  if(count!==Number(pack.timelineCount)||notes!==Number(pack.noteCount))throw new Error('Chart companion index totals do not match its manifest.');
  snapshot.assetRevision=Number(pack.assetRevision);snapshot.appVersion=pack.gameAppVersion;snapshot.timelineSource='Bundled validated live SUS r51 companion';snapshot.timelineCount=count;snapshot.resourceCount=Number(pack.resourceCount)||706;
  return {snapshot,source:`Bundled exact charts r${pack.assetRevision}`};
}
function chartPackBytes(){if(!CHART_PACK)throw new Error('Exact chart companion is not loaded. Keep Holodori_Chart_Data_r51.js beside the optimizer HTML.');if(!CHART_PACK_BYTES)CHART_PACK_BYTES=decodeBase64Bytes(CHART_PACK.data);return CHART_PACK_BYTES;}
function materializeChart(c){
  if(!c||!c.timelineAvailable)return c;if(Array.isArray(c.notes)&&Array.isArray(c.specialTimesMs))return c;if(!c.timelinePacked)throw new Error(`Timeline data is incomplete for ${c?.key||'selected chart'}.`);
  const cached=CHART_MATERIALIZED.get(c.key);if(cached)return cached;const row=CHART_PACK?.index?.[c.key];if(!row)throw new Error(`Packed timeline index is missing for ${c.key}.`);const [offset,count]=row.map(Number),bytes=chartPackBytes(),need=offset+count*4+20;if(need>bytes.byteLength)throw new Error(`Packed timeline is truncated for ${c.key}.`);const dv=new DataView(bytes.buffer,bytes.byteOffset,bytes.byteLength),notes=new Array(count);let pos=offset,t=0;
  for(let i=0;i<count;i++){t+=dv.getUint16(pos,true);const w=dv.getUint16(pos+2,true)/2;pos+=4;notes[i]=[t,w];}
  const specialTimesMs=new Array(5);for(let i=0;i<5;i++){specialTimesMs[i]=dv.getUint32(pos,true);pos+=4;}
  const full={...c,notes,specialTimesMs,timelineAvailable:true,timelinePacked:false,beatmapSeconds:t/1000};if(Number(full.fullComboNoteCount)!==notes.length)throw new Error(`Packed timeline note count mismatch for ${c.key}.`);CHART_MATERIALIZED.set(c.key,full);return full;
}
function materializeChartSnapshot(){if(!CHART_DB)return null;const out=structuredClone(CHART_DB);out.charts=out.charts.map(c=>c.timelineAvailable?structuredClone(materializeChart(c)):c);out.timelineCount=out.charts.filter(c=>c.timelineAvailable).length;return out;}

