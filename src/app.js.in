function inflateBundledMaster(p){const cards=p.cards.map(c=>{const x={...c};x.key=`${x.member} | ${x.name}`;x.attribute=p.attributeLabels[x.attributeId]||x.attributeId;x.groupLabels=(x.groupIds||[]).map(g=>p.groupLabels[g]||g);x.levelBaseValues=p.levelCurves[x.levelCurve];x.bloomStages=p.bloomProfiles[x.bloomProfile];delete x.levelCurve;delete x.bloomProfile;return x;});return{schemaVersion:p.schemaVersion,source:p.source,sourceVersion:p.sourceVersion,cards,groupLabels:p.groupLabels,attributeLabels:p.attributeLabels,counts:p.counts};}
